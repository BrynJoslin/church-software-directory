---
import { siteConfig } from "../config/site";
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <p class="footer-title">
        <span class="footer-brand-mark" aria-hidden="true"></span>
        <span>{siteConfig.name}</span>
      </p>
      <p>
        Independent information for considered software decisions. Inclusion is
        not endorsement.
      </p>
    </div>
    <nav class="footer-nav" aria-label="Footer navigation">
      <div>
        <p class="footer-nav__title">Directory</p>
        <ul class="footer-links">
          <li><a href="/software/">All software</a></li>
          <li><a href="/categories/">Categories</a></li>
          <li><a href="/compare/">Compare</a></li>
          <li><a href="/shortlist/">Build a shortlist</a></li>
        </ul>
      </div>
      <div>
        <p class="footer-nav__title">About</p>
        <ul class="footer-links">
          <li><a href="/about/">Why this exists</a></li>
          <li><a href="/methodology/">Methodology</a></li>
          <li><a href="/privacy/">Privacy</a></li>
          <li><a href="/affiliate-disclosure/">Affiliate disclosure</a></li>
        </ul>
      </div>
      <div>
        <p class="footer-nav__title">Contribute</p>
        <ul class="footer-links">
          <li><a href="/suggest-software/">Suggest software</a></li>
          <li><a href="/supplier-update/">Supplier update</a></li>
          <li><a href="/charity-software-discounts/">Charity discounts</a></li>
          <li><a href="/data/charity-offers.json">Charity-offer data</a></li>
          <li><a href="/data/software.json">Software data</a></li>
        </ul>
      </div>
    </nav>
  </div>
  <div class="container footer-bottom">
    <p>&copy; {new Date().getFullYear()} {siteConfig.name}.</p>
    <p>Product details can change. Check important decisions with the supplier.</p>
  </div>
</footer>
