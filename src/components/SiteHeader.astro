---
import { siteConfig } from "../config/site";

const currentPath = Astro.url.pathname;
const navItems = [
  { href: "/software/", label: "Software" },
  { href: "/charity-software-discounts/", label: "Charity discounts" },
  { href: "/categories/", label: "Categories" },
  { href: "/compare/", label: "Compare" },
  { href: "/guides/", label: "Guides" },
  { href: "/shortlist/", label: "Build a shortlist", featured: true }
];
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/" aria-label={`${siteConfig.name} home`}>
      <span class="brand-mark" aria-hidden="true"></span>
      <span>{siteConfig.shortName}</span>
    </a>
    <div class="header-actions">
      <button
        class="menu-toggle"
        type="button"
        aria-controls="primary-navigation"
        aria-expanded="false"
        aria-label="Open menu"
      >
        <span class="menu-toggle__icon" aria-hidden="true">
          <span></span>
          <span></span>
          <span></span>
        </span>
        <span>Menu</span>
      </button>
    </div>
    <nav id="primary-navigation" class="site-nav" aria-label="Primary navigation">
      <button class="menu-close" type="button">
        <span class="menu-close__icon" aria-hidden="true"></span>
        <span class="visually-hidden">Close menu</span>
      </button>
      <ul class="nav-list">
        {
          navItems.map((item) => (
            <li>
              <a
                class={item.featured ? "nav-cta" : undefined}
                href={item.href}
                aria-current={currentPath.startsWith(item.href) ? "page" : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<script is:inline>
  const menuToggle = document.querySelector(".menu-toggle");
  const primaryNavigation = document.querySelector("#primary-navigation");
  const menuClose = primaryNavigation?.querySelector(".menu-close");
  const mobileMenu = window.matchMedia("(max-width: 52rem)");

  if (menuToggle && primaryNavigation && menuClose) {
    const setMenuState = (isOpen) => {
      menuToggle.setAttribute("aria-expanded", String(isOpen));
      menuToggle.setAttribute("aria-label", isOpen ? "Close menu" : "Open menu");
      primaryNavigation.hidden = !isOpen;
      document.body.classList.toggle("menu-open", isOpen && mobileMenu.matches);

      if (isOpen && mobileMenu.matches) {
        primaryNavigation.setAttribute("role", "dialog");
        primaryNavigation.setAttribute("aria-label", "Site menu");
        primaryNavigation.setAttribute("aria-modal", "true");
        menuClose.focus();
      }
    };

    const syncMenuForViewport = () => {
      if (mobileMenu.matches) {
        setMenuState(false);
      } else {
        primaryNavigation.hidden = false;
        primaryNavigation.removeAttribute("role");
        primaryNavigation.setAttribute("aria-label", "Primary navigation");
        primaryNavigation.removeAttribute("aria-modal");
        document.body.classList.remove("menu-open");
      }
    };

    syncMenuForViewport();
    mobileMenu.addEventListener("change", syncMenuForViewport);

    menuToggle.addEventListener("click", () => {
      setMenuState(menuToggle.getAttribute("aria-expanded") !== "true");
    });

    menuClose.addEventListener("click", () => {
      setMenuState(false);
      menuToggle.focus();
    });

    primaryNavigation.addEventListener("click", (event) => {
      if (mobileMenu.matches && event.target instanceof HTMLAnchorElement) {
        setMenuState(false);
      }
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && mobileMenu.matches && !primaryNavigation.hidden) {
        setMenuState(false);
        menuToggle.focus();
      }

      if (event.key === "Tab" && mobileMenu.matches && !primaryNavigation.hidden) {
        const focusableElements = [...primaryNavigation.querySelectorAll(
          'a[href], button:not([disabled])'
        )];
        const firstElement = focusableElements[0];
        const lastElement = focusableElements.at(-1);

        if (!firstElement || !lastElement) return;

        if (event.shiftKey && document.activeElement === firstElement) {
          event.preventDefault();
          lastElement.focus();
        } else if (!event.shiftKey && document.activeElement === lastElement) {
          event.preventDefault();
          firstElement.focus();
        }
      }
    });
  }
</script>
