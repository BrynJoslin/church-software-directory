---
import type { CollectionEntry } from "astro:content";
import {
  formatCompactDate,
  triStateLabel,
  formatStartingPrice,
  ukFocusLabel
} from "../utils/content";

interface Props {
  entry: CollectionEntry<"software">;
  filterable?: boolean;
}

const { entry, filterable = false } = Astro.props;
const software = entry.data;
const startingPrice = formatStartingPrice(software.pricing.startingPrice);
const giftAid = software.giftAid ? triStateLabel(software.giftAid) : null;
const ukFocus = ukFocusLabel(software.ukFocus);
const bestFit = software.editorial.bestFor[0];
const relevantSignal = giftAid
  ? `Gift Aid: ${giftAid}`
  : ukFocus
    ? ukFocus
    : null;
const searchText = [
  software.name,
  software.shortDescription,
  ...software.coreFeatures,
  ...software.editorial.bestFor
]
  .join(" ")
  .toLowerCase();
---

<article
  class="software-card"
  data-software-card={filterable ? "" : undefined}
  data-name={software.name.toLowerCase()}
  data-search={searchText}
  data-categories={software.categories.map((category) => category.id).join(",")}
  data-uk-focus={software.ukFocus === "unknown" ? undefined : software.ukFocus}
  data-uk-organisation={software.ukOrganisation === "unknown" ? undefined : software.ukOrganisation}
  data-free-plan={software.freePlan === "unknown" ? undefined : software.freePlan}
  data-free-trial={software.freeTrial === "unknown" ? undefined : software.freeTrial}
  data-gift-aid={!software.giftAid || software.giftAid === "unknown" ? undefined : software.giftAid}
  data-pricing={software.pricing.model === "unknown" ? undefined : software.pricing.model}
  data-last-checked={software.lastChecked.toISOString().slice(0, 10)}
>
  <div class="card-heading">
    {
      software.brandAssets?.logo ? (
        <img
          class="software-logo software-logo--card"
          src={software.brandAssets.logo.src}
          alt={software.brandAssets.logo.alt}
          width="48"
          height="48"
        />
      ) : (
        <div class="logo-fallback" aria-hidden="true">
          {software.name.split(/\s+/).map((word) => word[0]).join("").slice(0, 2)}
        </div>
      )
    }
    <div>
      <h2><a href={`/software/${software.slug}/`} data-analytics-event="directory_profile_open">{software.name}</a></h2>
    </div>
  </div>
  <p>{software.shortDescription}</p>
  <dl class="compact-card-facts">
    {startingPrice && <div><dt>Published from</dt><dd>{startingPrice}</dd></div>}
    {relevantSignal && <div><dt>Relevant check</dt><dd>{relevantSignal}</dd></div>}
    {bestFit && <div><dt>Best fit</dt><dd>{bestFit}</dd></div>}
  </dl>
  <div class="compact-card-footer">
    <p class="card-meta">
      Last checked: <time datetime={software.lastChecked.toISOString().slice(0, 10)}>
        {formatCompactDate(software.lastChecked)}
      </time>
    </p>
    <a class="button button--secondary" href="/compare/" data-comparison-product={software.slug} data-analytics-event="comparison_add_from_card">Add to comparison</a>
  </div>
</article>
