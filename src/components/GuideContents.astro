---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
}

const { headings } = Astro.props;
const contentsHeadings = headings.filter((heading) => heading.depth >= 2 && heading.depth <= 3);
---

{
  contentsHeadings.length > 0 && (
    <aside class="guide-contents" data-guide-contents>
      <nav aria-labelledby="guide-contents-heading">
        <p class="guide-contents__label" id="guide-contents-heading">What's in this guide</p>
        <ol class="guide-contents__list">
          {contentsHeadings.map((heading, index) => (
            <li class:list={{ "guide-contents__item--nested": heading.depth === 3 }}>
              <a
                href={`#${heading.slug}`}
                data-guide-contents-link
                aria-current={index === 0 ? "location" : undefined}
              >
                {heading.text}
              </a>
            </li>
          ))}
        </ol>
      </nav>
    </aside>
  )
}

<script>
  const contents = document.querySelector<HTMLElement>("[data-guide-contents]");

  if (contents) {
    const links = Array.from(contents.querySelectorAll<HTMLAnchorElement>("[data-guide-contents-link]"));
    const headings = links
      .map((link) => {
        const id = link.getAttribute("href")?.slice(1);
        const heading = id ? document.getElementById(id) : null;
        return heading ? { link, heading } : null;
      })
      .filter((item): item is { link: HTMLAnchorElement; heading: HTMLElement } => item !== null);

    const setCurrent = (link: HTMLAnchorElement) => {
      links.forEach((item) => {
        if (item === link) {
          item.setAttribute("aria-current", "location");
        } else {
          item.removeAttribute("aria-current");
        }
      });

      link.scrollIntoView({ block: "nearest", inline: "nearest" });
    };

    const hashTarget = window.location.hash.slice(1);
    const linkedHashTarget = headings.find(({ heading }) => heading.id === hashTarget);
    if (linkedHashTarget) {
      setCurrent(linkedHashTarget.link);
    }

    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((entry) => entry.isIntersecting)
          .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top)[0];

        if (!visible) return;

        const current = headings.find(({ heading }) => heading === visible.target);
        if (current) setCurrent(current.link);
      },
      { rootMargin: "-18% 0px -68% 0px", threshold: 0 }
    );

    headings.forEach(({ heading }) => observer.observe(heading));
    links.forEach((link) => link.addEventListener("click", () => setCurrent(link)));
  }
</script>
