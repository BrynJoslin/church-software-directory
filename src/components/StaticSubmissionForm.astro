---
import { siteConfig } from "../config/site";

interface Props {
  kind: "suggest" | "update" | "supplier";
}

const { kind } = Astro.props;
const isSuggest = kind === "suggest";
const isSupplier = kind === "supplier";
const action = isSuggest
  ? siteConfig.forms.suggestSoftware
  : isSupplier
    ? siteConfig.forms.supplierUpdate
    : siteConfig.forms.updateListing;
---

{
  !siteConfig.forms.enabled ? (
    <div class="notice" role="status">
      <p>
        <strong>No submission route is configured.</strong> This page explains
        the evidence needed for a future contribution, but does not collect or
        send information until a real route is published.
      </p>
    </div>
  ) : (
<div class="static-form stack">
  <p>
    Contributions are handled through a public GitHub issue form so the evidence,
    editorial response and resolution can be tracked. A GitHub account may be
    required to submit.
  </p>
  <p>
    Use only public supplier information and business contact details. Do not
    include church-member, pastoral, safeguarding, financial or other sensitive
    information. See the <a href="/privacy/">privacy notice</a>.
  </p>
  <a class="button" href={action} target="_blank" rel="noopener noreferrer">
    {isSuggest ? "Open software suggestion form" : isSupplier ? "Open supplier update form" : "Open correction form"}
  </a>
</div>
  )
}
