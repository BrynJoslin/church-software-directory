---
import { siteConfig } from "../config/site";

interface Props {
  kind: "suggest" | "supplier";
}

const { kind } = Astro.props;
const isSuggest = kind === "suggest";
const subject = isSuggest
  ? "Church Software UK: software suggestion"
  : "Church Software UK: supplier update";
const body = isSuggest
  ? "Software name:\nOfficial website:\nWhy it may be relevant to UK churches:\nOfficial source URLs:\n\nPlease include public supplier information only. Do not include sensitive church or customer data."
  : "Directory listing URL:\nWhat has changed:\nOfficial source URLs:\n\nPlease include public supplier information only. Do not include sensitive church or customer data.";
const href = `mailto:${siteConfig.forms.contributionEmail}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
---

<div class="static-form stack">
  <p>
    Email public supplier information and business contact details to the
    directory. Do not include church-member, pastoral, safeguarding, financial
    or other sensitive information. See the <a href="/privacy/">privacy notice</a>.
  </p>
  <a class="button" href={href}>
    {isSuggest ? "Email a software suggestion" : "Email a supplier update"}
  </a>
</div>
