---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { categoryFamilies } from "../../utils/category-families";
import { shortlistJobs } from "../../utils/shortlist";

const software = (await getCollection("software")).sort((a, b) => a.data.name.localeCompare(b.data.name));
const products = software.map((entry) => ({
  slug: entry.data.slug,
  name: entry.data.name,
  categories: entry.data.categories.map((category) => category.id),
  suitableChurchSizes: entry.data.suitableChurchSizes,
  ukFocus: entry.data.ukFocus === "strong" ? "strong" : "general",
  giftAid: entry.data.giftAid === "unknown" ? undefined : entry.data.giftAid,
  pricing: {
    summary: entry.data.pricing.summary,
    startingPrice: entry.data.pricing.startingPrice
  },
  procurementVerdict: entry.data.editorial.procurementVerdict ?? {
    problem: entry.data.editorial.bestFor[0],
    firstCheck: entry.data.editorial.limitations[0]
  },
  decisionEvidence: entry.data.decisionEvidence
}));
---

<BaseLayout
  title="Build a church software shortlist"
  description="Use recorded church software evidence to create a small, explainable shortlist and a printable decision pack for your next conversation."
  breadcrumbs={[{ label: "Build a shortlist" }]}
>
  <section class="section">
    <div class="container shortlist-layout" data-shortlist data-products={JSON.stringify(products)}>
      <div class="shortlist-intro">
        <p class="eyebrow">Guided shortlist</p>
        <h1>Build a church software shortlist</h1>
        <p class="measure">Answer a few practical questions to find three to five products that match the recorded evidence. This is not a ranking or recommendation.</p>
        <noscript><div class="notice"><p>This guided shortlist needs JavaScript. You can still <a href="/categories/">browse categories</a> and compare products manually.</p></div></noscript>
        <form class="shortlist-form enhancement" data-shortlist-form action="/shortlist/" method="get">
          <div class="form-field">
            <label for="shortlist-job">What job needs improving?</label>
            <select id="shortlist-job" name="job" required>
              <option value="">Choose a job</option>
              {shortlistJobs.map((job) => <option value={job.value}>{job.label}</option>)}
            </select>
          </div>
          <div class="shortlist-form__grid">
            <div class="form-field"><label for="contact-band">Approximate church scale</label><select id="contact-band" name="contact-band"><option value="any">Not specified</option><option value="small">Smaller church</option><option value="medium">Medium church</option><option value="large">Larger church</option><option value="multi-site">Multi-site church</option></select><p class="field-hint">This uses editorial context, not a supplier contact limit.</p></div>
            <div class="form-field"><label for="uk-location">Church location</label><select id="uk-location" name="uk-location"><option value="any">Not specified</option><option value="yes">Based in the UK</option></select></div>
            <div class="form-field"><label for="gift-aid">Gift Aid need</label><select id="gift-aid" name="gift-aid"><option value="any">Not specified</option><option value="yes">Gift Aid is needed</option></select></div>
            <div class="form-field"><label for="approach">System preference</label><select id="approach" name="approach"><option value="any">No preference</option><option value="integrated">Prefer an integrated system</option><option value="specialist">Prefer a specialist tool</option></select></div>
            <div class="form-field"><label for="technical-administration">Technical administration</label><select id="technical-administration" name="technical-administration"><option value="any">Not specified</option><option value="limited">Limited capacity</option><option value="available">Capacity is available</option></select><p class="field-hint">This remains a question to test: the catalogue does not yet support filtering it reliably.</p></div>
          </div>
          <div class="cluster"><button type="submit">Build a shortlist</button><a class="button button--secondary" href="/shortlist/">Clear answers</a></div>
        </form>
      </div>

      <section class="shortlist-results enhancement" data-shortlist-results aria-live="polite" aria-labelledby="shortlist-results-heading" hidden>
        <div class="section-intro"><div><p class="eyebrow">Your shortlist</p><h2 id="shortlist-results-heading">Products to investigate</h2></div><button class="button button--secondary" type="button" data-print-pack>Print decision pack</button></div>
        <p data-shortlist-summary></p>
        <div class="shortlist-cards" data-shortlist-cards></div>
        <section class="decision-pack" data-decision-pack aria-labelledby="decision-pack-heading">
          <p class="eyebrow">Practical decision pack</p>
          <h2 id="decision-pack-heading">Take this into your next meeting</h2>
          <details open><summary>Requirements worksheet</summary><div data-pack-requirements></div></details>
          <details><summary>Supplier question pack</summary><div data-pack-questions></div></details>
          <details><summary>Four-week trial plan</summary><ol><li><strong>Week 1:</strong> Agree one real workflow, its owner and what success looks like.</li><li><strong>Week 2:</strong> Use safe sample data with the people who will do the ordinary work.</li><li><strong>Week 3:</strong> Test permissions, reporting, exports and the relevant finance or Gift Aid path.</li><li><strong>Week 4:</strong> Review what worked, what took extra effort and which questions still need answers from the supplier.</li></ol></details>
          <details><summary>Trustee or elder decision summary</summary><div data-pack-summary></div></details>
        </section>
      </section>

      <section class="empty-state enhancement" data-shortlist-empty hidden aria-labelledby="shortlist-empty-heading"><h2 id="shortlist-empty-heading">No evidence-backed shortlist yet</h2><p data-shortlist-empty-copy></p><p>Try relaxing one requirement, or check it directly with suppliers before making it a deciding condition. The tool will not silently widen your requirements.</p></section>

      <aside class="aside-card shortlist-rules"><h2>How this works</h2><p>The rules first require the selected job, then apply only the requirements with a clear structured match: scale, UK-specific evidence, recorded Gift Aid workflow and integrated or specialist preference.</p><p>Matches are shown with the selected job as a primary category first, then UK-specific evidence, then name. This is a tie-break, not a score or endorsement. Commercial relationships are never inputs.</p><p>Technical administration is included in the pack but not used to filter because too few profiles have evidence for it. Pricing is presented only as an individual, dated starting point where a public GBP price is recorded.</p><p>Browse by family: {categoryFamilies.map((family) => <span class="shortlist-family">{family.name}</span>)}</p></aside>
    </div>
  </section>
  <script src="../../scripts/shortlist.ts"></script>
</BaseLayout>
