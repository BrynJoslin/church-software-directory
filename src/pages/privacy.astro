---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Privacy"
  description="Privacy information for Church Software UK, including current analytics, form and structured-data practices."
  breadcrumbs={[{ label: "Privacy" }]}
>
  <section class="section">
    <div class="container prose">
      <p class="eyebrow">Privacy notice</p>
      <h1>Privacy</h1>
      <p>Last updated: 25 July 2026.</p>

      <h2>Current site state</h2>
      <p>
        Analytics are disabled and no public form or contact route is configured.
        The site does not intentionally set analytics or advertising cookies.
      </p>

      <h2>Hosting logs</h2>
      <p>
        The configured production domain is served through Cloudflare, checked on
        25 July 2026. The responsible publisher and final privacy contact have
        not yet been confirmed. Routine hosting may process information such as
        IP addresses, browser details and timestamps for security and service
        operation.
      </p>

      <h2>Future form submissions</h2>
      <p>
        Before forms are enabled, this notice must be updated with the responsible
        organisation, contact details, purposes, lawful basis, processors,
        retention and rights information. Do not send sensitive church-member
        information through a correction or suggestion form.
      </p>

      <h2>Public software data</h2>
      <p>
        The structured export contains publishable product information and public
        supplier-source URLs. It does not contain private editorial notes or user
        submissions.
      </p>
    </div>
  </section>
</BaseLayout>
