---
import { getCollection, render, type CollectionEntry } from "astro:content";
import SoftwareCard from "../../components/SoftwareCard.astro";
import GuideCard from "../../components/GuideCard.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const categories = await getCollection("categories");
  return categories.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { entry }
  }));
}

interface Props {
  entry: CollectionEntry<"categories">;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const [allSoftware, allGuides, allCategories] = await Promise.all([
  getCollection("software"),
  getCollection("guides"),
  getCollection("categories")
]);
const relevantSoftware = allSoftware
  .filter((software) =>
    software.data.categories.some((category) => category.id === entry.id)
  )
  .sort((a, b) => a.data.name.localeCompare(b.data.name));
const featuredGuides = allGuides.filter((guide) =>
  guide.data.featuredOnCategories.some((category) => category.id === entry.id)
);
const categoryNames = Object.fromEntries(allCategories.map((category) => [category.id, category.data.name]));
---

<BaseLayout
  title={entry.data.seo.title}
  description={entry.data.seo.description}
  breadcrumbs={[
    { label: "Categories", href: "/categories/" },
    { label: entry.data.name }
  ]}
>
  <section class="section">
    <div class="container page-grid">
      <article class="prose">
        <p class="eyebrow">Software category</p>
        <h1>{entry.data.name}</h1>
        <p>{entry.data.shortDescription}</p>
        <Content />
      </article>
      <aside class="aside-card">
        <h2>Who usually manages this?</h2>
        <ul>{entry.data.ownerRoles.map((role) => <li>{role}</li>)}</ul>
        <h2>UK considerations</h2>
        <ul>
          {entry.data.ukConsiderations.map((item) => <li>{item}</li>)}
        </ul>
      </aside>
    </div>
  </section>

  <section class="section section--soft" aria-labelledby="criteria-heading">
    <div class="container">
      <h2 id="criteria-heading">Selection criteria</h2>
      <ul class="measure">
        {entry.data.selectionCriteria.map((item) => <li>{item}</li>)}
      </ul>
    </div>
  </section>

  {
    featuredGuides.length > 0 && (
      <section class="section" aria-labelledby="category-guides-heading">
        <div class="container">
          <div class="section-intro">
            <div>
              <p class="eyebrow">Decision support</p>
              <h2 id="category-guides-heading">Guides for this decision</h2>
            </div>
            <p>These guides help you frame the work and questions around {entry.data.name.toLocaleLowerCase("en-GB")}.</p>
          </div>
          <div class="grid">
            {featuredGuides.map((guide) => <GuideCard entry={guide} categoryNames={categoryNames} analyticsEvent="guide_open_from_category" />)}
          </div>
          <p class="section-link"><a href={`/guides/?category=${entry.data.slug}`}>See all guides about {entry.data.name}</a></p>
        </div>
      </section>
    )
  }

  <section class="section" aria-labelledby="products-heading">
    <div class="container">
      <h2 id="products-heading">Products in this category</h2>
      {
        relevantSoftware.length > 0 ? (
          <div class="software-grid" data-result-reveal>
            {relevantSoftware.map((software) => (
              <SoftwareCard entry={software} filterable />
            ))}
          </div>
          <p class="result-reveal-status enhancement" data-result-reveal-status role="status" aria-live="polite"></p>
          <p class="result-reveal-actions enhancement">
            <button class="button button--secondary" type="button" data-show-more-results data-analytics-event="category_show_more">Show more products</button>
          </p>
        ) : (
          <div class="empty-state">
            <p>No researched products have been added to this category yet.</p>
          </div>
        )
      }
    </div>
  </section>
</BaseLayout>

<script src="../../scripts/prose-tables.ts"></script>
<script src="../../scripts/result-reveal.ts"></script>
