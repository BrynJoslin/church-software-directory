---
import { getCollection } from "astro:content";
import CategoryCard from "../../components/CategoryCard.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { categoryFamilies } from "../../utils/category-families";

const [categories, software] = await Promise.all([
  getCollection("categories"),
  getCollection("software")
]);
const categoriesById = new Map(categories.map((category) => [category.id, category]));
---

<BaseLayout
  title="Church software categories"
  description="Understand the problems different church software categories solve, when simpler tools may be enough and which UK questions to ask."
  breadcrumbs={[{ label: "Categories" }]}
  editorialHero
>
  <section class="section page-hero page-hero--editorial">
    <div class="container page-hero__grid">
      <div class="page-hero__intro">
        <p class="eyebrow">Browse by church task</p>
        <h1>Church software categories</h1>
        <p>
          Start with the work your church needs help with. Then decide whether a
          specialist system is worth using.
        </p>
      </div>
      <nav class="page-hero__routes" aria-label="Category next steps">
        <a href="/shortlist/"><span>Not sure where to begin?</span><strong>Build a shortlist</strong></a>
        <a href="/software/"><span>Know what you need?</span><strong>Search all software</strong></a>
      </nav>
    </div>
  </section>

  <section class="section category-library" aria-label="Software category families">
    <div class="container">
      <div class="category-families">
        {categoryFamilies.map((family) => (
          <section class="category-family" aria-labelledby={`family-${family.name}`}>
            <div class="category-family__intro">
              <p class="eyebrow">Category family</p>
              <h2 id={`family-${family.name}`}>{family.name}</h2>
              <p>{family.description}</p>
            </div>
            <div class="grid">
              {family.categories.map((categoryId) => {
                const category = categoriesById.get(categoryId);
                return category ? <CategoryCard entry={category} productCount={software.filter((entry) => entry.data.categories.some((item) => item.id === category.id)).length} /> : null;
              })}
            </div>
          </section>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
