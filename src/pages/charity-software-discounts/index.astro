---
import { getCollection } from "astro:content";
import CharityOfferCard from "../../components/CharityOfferCard.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";

const offers = (await getCollection("charityOffers")).sort((a, b) => a.data.name.localeCompare(b.data.name));
const published = offers.filter((entry) => entry.data.publicationStatus === "published");
const warnings = offers.filter((entry) => entry.data.publicationStatus === "warning");
const startingSlugs = new Set(["google-for-nonprofits", "microsoft-for-nonprofits", "canva-for-nonprofits", "sage-nonprofit-discounts"]);
const startingPoints = published.filter((entry) => startingSlugs.has(entry.data.slug));
const jsonLd = [{ "@context": "https://schema.org", "@type": "CollectionPage", name: "Software discounts for UK churches and charities", description: "Current software discounts, donated licences and credits for UK churches, with checked sources.", url: new URL("/charity-software-discounts/", Astro.site).href }, { "@context": "https://schema.org", "@type": "ItemList", name: "UK charity software programmes", numberOfItems: published.length, itemListElement: published.map((entry, index) => ({ "@type": "ListItem", position: index + 1, name: entry.data.name, url: entry.data.application.url })) }];
---
<BaseLayout title="Software discounts for UK churches and charities" description="Find current software discounts, donated licences and credits for UK churches, with church eligibility, application routes and checked sources." breadcrumbs={[{ label: "Charity software discounts" }]} jsonLd={jsonLd}>
  <section class="section charity-hero"><div class="container"><p class="eyebrow">Evidence-led register</p><h1>Software discounts for UK churches and charities</h1><p class="measure lead">Churches may qualify for charity pricing, donated licences or credits, but every programme has its own UK and religious-eligibility rules. Check the provider's current terms before committing.</p></div></section>
  <section class="section section--soft"><div class="container charity-two-column"><div><h2>Before you apply</h2><ul class="checklist"><li>Identify the legal body that will apply.</li><li>Gather the regulator, HMRC or governing evidence the provider accepts.</li><li>Use an organisational email address.</li><li>Count eligible staff and volunteer seats, not the congregation.</li><li>Compare the full cost after the discounted term, including VAT and implementation.</li></ul></div><aside class="trust-panel"><h2>Eligibility is not guaranteed</h2><p>“A UK registered charity may qualify” means the provider publishes a charity route; it does not promise acceptance for a particular church.</p></aside></div></section>
  <section class="section"><div class="container"><p class="eyebrow">Best-established starting points</p><h2>Four places to begin your research</h2><p class="measure">These are not ranked recommendations. They are established programmes with clear public routes; choose based on the work your church needs to do.</p><div class="grid charity-starting-grid">{startingPoints.map((entry) => <CharityOfferCard entry={entry} />)}</div></div></section>
  <section class="section section--soft" aria-labelledby="offers-heading"><div class="container"><div class="section-intro"><div><p class="eyebrow">Current programmes</p><h2 id="offers-heading">Search charity software programmes</h2><p>All current programmes appear in the page HTML. Filters are an optional, keyboard-accessible enhancement.</p></div><p data-charity-result-count role="status" aria-live="polite">{published.length} programmes</p></div><noscript><div class="notice"><p>All current programmes are shown below. Enable JavaScript to filter the register.</p></div></noscript><div class="directory-layout charity-offer-layout"><aside class="filter-panel enhancement" aria-labelledby="charity-filter-heading"><h3 id="charity-filter-heading">Filter programmes</h3><form action="/charity-software-discounts/" method="get" data-charity-offer-form><div class="form-field"><label for="charity-search">Search</label><input id="charity-search" name="q" type="search" placeholder="Product or task" autocomplete="off" /></div><div class="form-field"><label for="charity-category">Task</label><select id="charity-category" name="category"><option value="">All tasks</option><option value="office-collaboration">Office & collaboration</option><option value="communications-design">Communications & design</option><option value="work-management">Work management</option><option value="finance-payroll">Finance & payroll</option><option value="crm-fundraising">CRM & fundraising</option><option value="meetings-events">Meetings & events</option><option value="payments">Payments</option><option value="security">Security</option><option value="ai-cloud-developer">AI, cloud & developer</option></select></div><div class="form-field"><label for="charity-benefit">Benefit type</label><select id="charity-benefit" name="benefit"><option value="">All benefit types</option><option value="donated-plan">Donated plan</option><option value="donated-licences">Donated licences</option><option value="subscription-discount">Subscription discount</option><option value="transaction-rate">Transaction rate</option><option value="usage-credit">Usage credit</option><option value="advertising-credit">Advertising credit</option></select></div><div class="form-field"><label for="charity-eligibility">Church eligibility</label><select id="charity-eligibility" name="eligibility"><option value="">All visible statuses</option><option value="explicitly-eligible">Churches explicitly included</option><option value="registered-charity-route">Registered-charity route</option><option value="confirm-first">Confirm first</option></select></div><div class="filter-actions"><button type="submit">Apply filters</button><button class="button--secondary" type="button" data-charity-clear>Clear all</button></div></form></aside><div><div class="charity-offer-grid">{published.map((entry) => <CharityOfferCard entry={entry} filterable />)}</div><div class="empty-state" data-charity-empty-state hidden><h3>No programmes match those filters</h3><p>Try removing one or more filters. Missing evidence is not treated as a negative answer.</p><button class="button--secondary" type="button" data-charity-clear>Clear all filters</button></div></div></div></div></section>
  <section class="section" aria-labelledby="warnings-heading"><div class="container"><p class="eyebrow">Not available or confirm first</p><h2 id="warnings-heading">Useful exclusions to know about</h2><p class="measure">These programmes are listed to prevent a likely mistake, not as available offers for churches.</p><div class="charity-offer-grid charity-warning-grid">{warnings.map((entry) => <CharityOfferCard entry={entry} />)}</div></div></section>
  <section class="section section--soft"><div class="container charity-two-column"><div><h2>How eligibility checks work</h2><h3>Goodstack</h3><p>Goodstack assesses many international nonprofit programmes. Its decision does not override a supplier's exclusions or guarantee approval.</p><h3>TechSoup UK and Charity Digital</h3><p>These are UK access routes for some products, not one giant discount. Product eligibility and administration fees can still apply.</p><h3>Direct supplier checks</h3><p>A provider may request a regulator entry, HMRC recognition, governing document, official email address or evidence that the applicant is authorised.</p></div><div><h2>Application and renewal checklist</h2><ul class="checklist"><li>Record the evidence submitted and the eligible seats.</li><li>Check currency, VAT, annual commitment and renewal date.</li><li>Budget for migration, training and administration.</li><li>Check data export before adopting a discounted plan.</li><li>Assign an accountable owner for renewal and supplier notices.</li></ul></div></div></section>
  <section class="section"><div class="container measure"><h2>Method and research limits</h2><p>We include programmes only where a current supplier or authorised route establishes an offer and a useful UK eligibility classification. We prefer first-party sources, show the checked date, and do not treat inclusion as endorsement or a guarantee of approval. We do not carry out hands-on testing or calculate theoretical savings totals.</p><p>Not every English or Welsh church has a Charity Commission number. Excepted, exempt and smaller charities may need different evidence; use the provider's accepted route and do not change legal structure solely to seek a discount. <a href="https://www.gov.uk/government/publications/excepted-charities" target="_blank" rel="noopener noreferrer">Read the Charity Commission's excepted-charity guidance <span class="visually-hidden">(opens in a new tab)</span></a>.</p><p>Found a change or a missing programme? <a href="/supplier-update/">Send a supplier update</a>. Published and warning records are reviewed every 90 days and blocked once more than 120 days old.</p></div></section>
  <script src="../../scripts/charity-offers.ts"></script>
</BaseLayout>
