---
import { getCollection } from "astro:content";
import CategoryCard from "../components/CategoryCard.astro";
import GuideCard from "../components/GuideCard.astro";
import SoftwareCard from "../components/SoftwareCard.astro";
import { siteConfig } from "../config/site";
import BaseLayout from "../layouts/BaseLayout.astro";

const [software, categories, guides] = await Promise.all([
  getCollection("software"),
  getCollection("categories"),
  getCollection("guides")
]);
const sortedSoftware = software
  .sort((a, b) => a.data.name.localeCompare(b.data.name))
  .slice(0, 3);
const sortedCategories = categories.sort((a, b) =>
  a.data.name.localeCompare(b.data.name)
);
const categoryNames = new Map(
  categories.map((category) => [category.id, category.data.name])
);
const websiteJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: siteConfig.name,
  url: siteConfig.url,
  description: siteConfig.description
};
---

<BaseLayout
  title="Make a better church software decision"
  description="Start with the job your church needs to do, then compare software using UK-specific evidence and practical supplier questions."
  jsonLd={websiteJsonLd}
>
  <section class="hero hero--home">
    <div class="container hero-grid">
      <div>
        <p class="eyebrow">Independent help for UK churches</p>
        <h1>Make the next software decision with less guesswork.</h1>
        <p>
          Church admin is already a lot. Start with the job that needs making
          easier, then assess the software behind the sales language — including
          the UK details that are easy to miss.
        </p>
        <div class="cluster">
          <a class="button" href="/shortlist/">Build a shortlist</a>
          <a class="button button--secondary" href="/compare/">Compare products</a>
        </div>
      </div>
      <aside class="trust-panel trust-panel--questions" aria-label="Questions the directory helps churches ask">
        <p class="eyebrow">The awkward questions</p>
        <h2>Not just “does it have the feature?”</h2>
        <ul>
          <li>Will this work with our actual people and processes?</li>
          <li>What needs checking for Gift Aid, GDPR and UK payments?</li>
          <li>What do the sources say — and what should we ask the supplier?</li>
        </ul>
        <p><a href="/methodology/">How we research listings</a></p>
      </aside>
    </div>
  </section>

  <section class="section home-problem" aria-labelledby="problem-heading">
    <div class="container home-problem__grid">
      <div>
        <p class="eyebrow">A familiar situation</p>
        <h2 id="problem-heading">You do not need more software. You need fewer loose ends.</h2>
      </div>
      <div class="home-problem__copy">
        <p>
          Perhaps information lives in too many places. Maybe giving is hard to
          reconcile, rotas keep changing, or a database has become difficult to
          trust. The right next step may be a new tool — but it may also be a
          clearer process or a simpler setup.
        </p>
        <p>
          This directory is here to help you tell the difference before your
          church commits time, money and sensitive data.
        </p>
      </div>
    </div>
  </section>

  <section class="section section--soft" aria-labelledby="path-heading">
    <div class="container">
      <div class="section-intro">
        <div>
          <p class="eyebrow">A calmer way to choose</p>
          <h2 id="path-heading">Find a way forward in three useful steps.</h2>
        </div>
        <p>
          No league tables or invented certainty. Just a clearer route from a
          real problem to an informed conversation.
        </p>
      </div>
      <ol class="decision-path">
        <li>
          <span class="decision-path__number" aria-hidden="true">01</span>
          <h3>Name the job</h3>
          <p>Begin with what is getting harder to manage, not a product name.</p>
        </li>
        <li>
          <span class="decision-path__number" aria-hidden="true">02</span>
          <h3>Check the fit</h3>
          <p>Use practical criteria and UK-specific questions to narrow the field.</p>
        </li>
        <li>
          <span class="decision-path__number" aria-hidden="true">03</span>
          <h3>Compare the evidence</h3>
          <p>Put sourced facts and unanswered questions side by side.</p>
        </li>
      </ol>
    </div>
  </section>

  <section class="section" aria-labelledby="tasks-heading">
    <div class="container">
      <div class="section-intro">
        <div>
          <p class="eyebrow">Start where the work is</p>
          <h2 id="tasks-heading">What would you like your church to handle better?</h2>
        </div>
        <p>Choose a task to see what is worth considering before you choose a tool.</p>
      </div>
      <p class="measure">If your first need is administration, finance or giving, build a guided shortlist. It explains the evidence behind each product and does not produce a league table.</p>
      <p class="section-link"><a class="button" href="/shortlist/">Build a shortlist</a></p>
      <div class="grid home-task-grid">
        {
          sortedCategories.map((category) => (
            <CategoryCard
              entry={category}
              productCount={
                software.filter((entry) =>
                  entry.data.categories.some((item) => item.id === category.id)
                ).length
              }
            />
          ))
        }
      </div>
      <p class="section-link"><a href="/categories/">Explore every software category</a></p>
    </div>
  </section>

  <section class="section section--warm" aria-labelledby="software-heading">
    <div class="container">
      <div class="section-intro">
        <div>
          <p class="eyebrow">A small, researched starting point</p>
          <h2 id="software-heading">Products need context, not a podium.</h2>
        </div>
        <p>
          These foundation listings are deliberately not a “best of” list. Each
          shows the evidence we have, the gaps we have found and who may want to
          investigate further.
        </p>
      </div>
      <div class="software-grid">
        {
          sortedSoftware.map((entry) => (
            <SoftwareCard entry={entry} categoryNames={categoryNames} />
          ))
        }
      </div>
      <p class="section-link"><a href="/software/">See all {software.length} software entries</a></p>
    </div>
  </section>

  <section class="section" aria-labelledby="guides-heading">
    <div class="container page-grid home-guides">
      <div>
        <p class="eyebrow">Before you commit</p>
        <h2 id="guides-heading">A good decision is more than a feature checklist.</h2>
        <p class="measure">
          Our guides help teams ask better questions about data, cost, migration
          and day-to-day ownership — so the decision still makes sense after the
          launch meeting.
        </p>
      </div>
      <div class="home-guide-list">
        {guides.map((guide) => <GuideCard entry={guide} />)}
      </div>
    </div>
  </section>

  <section class="section home-closing" aria-labelledby="closing-heading">
    <div class="container home-closing__grid">
      <div>
        <p class="eyebrow">Keep the directory useful</p>
        <h2 id="closing-heading">The useful answer is sometimes “not yet”.</h2>
        <p>
          A new system is only worthwhile when it solves a real problem your
          church can support well. If a listing is incomplete or out of date,
          help us improve it with first-party evidence.
        </p>
      </div>
      <div class="cluster">
        <a class="button" href="/update-a-listing/">Suggest a correction</a>
        <a class="button button--secondary" href="/about/">Why this exists</a>
      </div>
    </div>
  </section>
</BaseLayout>
