---
import { getCollection } from "astro:content";
import CategoryCard from "../components/CategoryCard.astro";
import GuideCard from "../components/GuideCard.astro";
import { siteConfig } from "../config/site";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getDirectoryStats } from "../utils/directory-stats";

const [software, categories, guides] = await Promise.all([
  getCollection("software"),
  getCollection("categories"),
  getCollection("guides")
]);
const commonCategorySlugs = [
  "church-management",
  "church-accounting",
  "online-giving",
  "presentation-software"
];
const commonCategories = commonCategorySlugs.flatMap((slug) => {
  const category = categories.find((entry) => entry.data.slug === slug);
  return category ? [category] : [];
});
const directoryStats = getDirectoryStats(software);
const featuredGuides = [...guides]
  .filter((guide) => guide.data.startHereOrder)
  .sort((a, b) => a.data.startHereOrder! - b.data.startHereOrder!);
const categoryNames = Object.fromEntries(categories.map((category) => [category.id, category.data.name]));
const websiteJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: siteConfig.name,
  url: siteConfig.url,
  description: siteConfig.description
};
---

<BaseLayout
  title="Find church software that works in the UK"
  description="Search independently researched church software for UK churches, compare known products and build a practical shortlist using sourced evidence."
  jsonLd={websiteJsonLd}
>
  <section class="hero hero--home">
    <div class="container hero-grid">
      <div>
        <p class="eyebrow">Independent help for UK churches</p>
        <h1>Find church software that <em>actually works</em> in the UK.</h1>
        <p>
          Search {directoryStats.listingCount} researched profiles for the job your church
          needs to do. Pricing, Gift Aid, UK availability, data handling and
          exports are recorded where current evidence is available.
        </p>
      </div>
      <dl class="hero-stats" aria-label="Directory at a glance">
        <div>
          <dt>Researched profiles</dt>
          <dd>{directoryStats.listingCount}</dd>
        </div>
        <div>
          <dt>Dated source links</dt>
          <dd>{directoryStats.sourceLinkCount}</dd>
        </div>
        <div>
          <dt>Paid rankings</dt>
          <dd>0</dd>
        </div>
      </dl>
    </div>
    <div class="container home-search-shell">
      <form class="home-search" action="/software/" method="get" data-analytics-event="homepage_search">
        <div class="home-search__meta">
          <label for="home-search">Search the directory</label>
          <span>{directoryStats.listingCount} profiles · {directoryStats.sourceLinkCount} dated sources</span>
        </div>
        <div class="home-search__controls">
          <input
            id="home-search"
            name="q"
            type="search"
            placeholder="Try giving, rotas, Gift Aid or church management"
          />
          <button type="submit">Search software</button>
        </div>
        <div class="home-search__starting-points" aria-label="Common search starting points">
          <span>Common starting points:</span>
          <a href="/software/?q=church+management">Church management</a>
          <a href="/software/?q=online+giving">Online giving</a>
          <a href="/software/?q=Gift+Aid">Gift Aid</a>
          <a href="/software/?q=rotas">Rotas</a>
          <a href="/software/?q=presentation">Presentation</a>
        </div>
      </form>
    </div>
  </section>

  <section class="home-trust-strip" aria-label="Directory standards">
    <div class="container">
      <ul>
        <li>UK-specific checks where relevant</li>
        <li>Dated first-party evidence</li>
        <li>Missing answers become questions</li>
        <li>No paid rankings</li>
      </ul>
    </div>
  </section>

  <section class="section section--ink" aria-labelledby="routes-heading">
    <div class="container">
      <div class="section-intro">
        <div>
          <p class="eyebrow">Choose a starting point</p>
          <h2 id="routes-heading">Three clear ways to get moving.</h2>
        </div>
        <p>Use the route that fits what you know already. Each keeps the next step practical and shareable.</p>
      </div>
      <ol class="decision-path">
        <li>
          <span class="decision-path__number" aria-hidden="true">01</span>
          <h3>Browse by task</h3>
          <p>Start with the work that needs making easier, from administration to giving or presentation.</p>
          <a class="decision-path__link" href="/software/" aria-label="Open the software directory" data-analytics-event="homepage_directory_entry">Open the directory <span aria-hidden="true">→</span></a>
        </li>
        <li>
          <span class="decision-path__number" aria-hidden="true">02</span>
          <h3>Compare known products</h3>
          <p>Put sourced facts and unresolved questions side by side for two to four products.</p>
          <a class="decision-path__link" href="/compare/" data-analytics-event="homepage_comparison_entry">Build a comparison <span aria-hidden="true">→</span></a>
        </li>
        <li>
          <span class="decision-path__number" aria-hidden="true">03</span>
          <h3>Build a guided shortlist</h3>
          <p>Answer a few practical questions to find explained starting points rather than a league table.</p>
          <a class="decision-path__link" href="/shortlist/" data-analytics-event="homepage_shortlist_start">Answer a few questions <span aria-hidden="true">→</span></a>
        </li>
      </ol>
    </div>
  </section>

  <section class="section" aria-labelledby="tasks-heading">
    <div class="container">
      <div class="section-intro">
        <div>
          <p class="eyebrow">Start where the work is</p>
          <h2 id="tasks-heading">What would you like your church to handle better?</h2>
        </div>
        <p>These are common starting points, selected to cover the core church-software decisions.</p>
      </div>
      <div class="grid home-task-grid">
        {
          commonCategories.map((category) => (
            <CategoryCard
              entry={category}
              productCount={
                software.filter((entry) =>
                  entry.data.categories.some((item) => item.id === category.id)
                ).length
              }
            />
          ))
        }
      </div>
      <p class="section-link"><a href="/categories/">Explore every software category</a></p>
    </div>
  </section>

  <section class="section section--soft home-method" aria-labelledby="method-heading">
    <div class="container home-method__grid">
      <div>
        <p class="eyebrow">A decision resource, not a ranking</p>
        <h2 id="method-heading">Published facts are tied to dated sources. Missing answers stay visible.</h2>
        <p>That makes uncertainty useful: it becomes a precise supplier question rather than a guessed feature or a misleading “no”.</p>
        <div class="cluster">
          <a class="button" href="/methodology/">How we research listings</a>
          <a class="button button--secondary" href="/about/">Why this exists</a>
        </div>
      </div>
      <dl class="home-principles">
        <div>
          <dt>No paid rankings</dt>
          <dd>Suppliers cannot buy a position, badge or more favourable write-up.</dd>
        </div>
        <div>
          <dt>Inclusion is not endorsement</dt>
          <dd>A profile means a product has been researched, not recommended.</dd>
        </div>
        <div>
          <dt>Dated evidence</dt>
          <dd>{directoryStats.sourceLinkCount} source links record when the supporting page was checked.</dd>
        </div>
        <div>
          <dt>Corrections are welcome</dt>
          <dd>Evidence-backed changes can be submitted through the public update route.</dd>
        </div>
      </dl>
    </div>
  </section>

  <section class="section" aria-labelledby="guides-heading">
    <div class="container home-guides">
      <div class="section-intro">
        <div>
          <p class="eyebrow">Before you commit</p>
          <h2 id="guides-heading">A good decision is more than a feature checklist.</h2>
        </div>
        <p>Practical guidance on data, cost, migration and day-to-day ownership, written for decisions that need to last beyond launch.</p>
      </div>
      <div class="home-guide-list">
        {featuredGuides.map((guide) => <GuideCard entry={guide} categoryNames={categoryNames} />)}
      </div>
      <p class="section-link"><a href="/guides/">Explore all guides</a></p>
    </div>
  </section>

  <section class="section home-closing" aria-labelledby="closing-heading">
    <div class="container home-closing__grid">
      <div>
        <p class="eyebrow">Keep the directory useful</p>
        <h2 id="closing-heading">The useful answer is sometimes “not yet”.</h2>
        <p>
          A new system is only worthwhile when it solves a real problem your
          church can support well. If a listing is incomplete or out of date,
          help us improve it with first-party evidence.
        </p>
      </div>
      <div class="home-closing__links">
        <a href="/charity-software-discounts/">Church and charity discounts <span aria-hidden="true">→</span></a>
        <a href="/supplier-update/">Suggest an update <span aria-hidden="true">→</span></a>
        <a href="/data/software.json">Browse the structured data <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>
</BaseLayout>
