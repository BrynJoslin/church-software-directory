---
import { getCollection } from "astro:content";
import { siteConfig } from "../../config/site";
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  decisionFieldDefinitions,
  decisionFieldsFor,
  evidenceStateLabel,
  type DecisionField,
  type DecisionFieldKey
} from "../../utils/decision-evidence";
import { formatCompactDate } from "../../utils/content";
import { getDirectoryStats } from "../../utils/directory-stats";

const software = (await getCollection("software")).sort((a, b) =>
  a.data.name.localeCompare(b.data.name)
);
const directoryStats = getDirectoryStats(software);
const fieldsBySlug = new Map(
  software.map((entry) => [
    entry.data.slug,
    new Map(decisionFieldsFor(entry).map((field) => [field.key, field]))
  ])
);
const fieldsFor = (slug: string, key: DecisionFieldKey) =>
  fieldsBySlug.get(slug)?.get(key) as DecisionField | undefined;
const comparisonStartingPoints = [
  ["churchsuite", "iknow-church"],
  ["expenseplus", "liberty-accounts"],
  ["propresenter", "easyworship"],
  ["churchsuite", "churchtools"],
  ["parish-giving-scheme", "stewardship"]
].flatMap(([firstSlug, secondSlug]) => {
  const first = software.find((entry) => entry.data.slug === firstSlug);
  const second = software.find((entry) => entry.data.slug === secondSlug);
  return first && second && decisionFieldsFor(first).length >= 4 && decisionFieldsFor(second).length >= 4
    ? [{ first, second }]
    : [];
});
---

<BaseLayout
  title="Compare church software"
  description="Compare two to four church software products using field-level evidence, current source dates and unresolved supplier questions."
  breadcrumbs={[{ label: "Compare" }]}
>
  <section class="section">
    <div class="container">
      <p class="eyebrow">Due diligence comparison</p>
      <h1>Compare church software</h1>
      <p class="measure">
        Choose two to four products. The comparison separates material differences,
        shared evidence and practical questions to settle before choosing.
      </p>

      <noscript>
        <div class="notice">
          <p>
            Searchable comparison selection is enhanced in the browser. Every
            product is listed below so you can open the records you need.
          </p>
          <details>
            <summary>Browse all {directoryStats.listingCount} product profiles</summary>
            <ul class="comparison-fallback-list">
              {software.map((entry) => <li><a href={`/software/${entry.data.slug}/`}>{entry.data.name}</a></li>)}
            </ul>
          </details>
        </div>
      </noscript>

      <form class="comparison-picker enhancement" data-comparison-picker data-site-url={siteConfig.url}>
        <fieldset class="comparison-selector-set">
          <legend><strong>Products to compare</strong></legend>
          <p>Choose two to four products. Search each slot, then optionally narrow it by category.</p>
          <div class="comparison-selectors">
            {[1, 2, 3, 4].map((slot) => (
              <fieldset class="comparison-selector" data-comparison-selector>
                <legend>Product {slot}</legend>
                <label for={`comparison-search-${slot}`}>Search products</label>
                <input id={`comparison-search-${slot}`} type="search" data-comparison-search placeholder="Type a product name" />
                <label for={`comparison-category-${slot}`}>Category</label>
                <select id={`comparison-category-${slot}`} data-comparison-category>
                  <option value="">All categories</option>
                  {Array.from(new Set(software.flatMap((entry) => entry.data.categories.map((category) => category.id)))).sort().map((category) => (
                    <option value={category}>{category.replaceAll("-", " ")}</option>
                  ))}
                </select>
                <label for={`comparison-product-${slot}`}>Product</label>
                <select id={`comparison-product-${slot}`} name="products" data-comparison-product-select>
                  <option value="">Choose a product</option>
                  {software.map((entry) => (
                    <option value={entry.data.slug} data-categories={entry.data.categories.map((category) => category.id).join(",")}>
                      {entry.data.name}
                    </option>
                  ))}
                </select>
              </fieldset>
            ))}
          </div>
        </fieldset>
        <div class="cluster">
          <button type="button" data-copy-comparison data-analytics-event="comparison_link_copy">Copy comparison link</button>
          <a class="button button--secondary" href="/compare/">Clear selection</a>
        </div>
      </form>

      {
        comparisonStartingPoints.length > 0 && (
          <section class="comparison-starting-points" aria-labelledby="comparison-starting-points-heading">
            <p class="eyebrow">Comparison starting points</p>
            <h2 id="comparison-starting-points-heading">Start with a factual side-by-side check</h2>
            <p class="measure">These pairs have enough structured evidence to open a comparison. They are not endorsements, rankings or claims that the products are interchangeable.</p>
            <ul>
              {comparisonStartingPoints.map(({ first, second }) => (
                <li><a href="/compare/" data-comparison-products={`${first.data.slug},${second.data.slug}`} data-analytics-event="comparison_starting_point">Compare {first.data.name} and {second.data.name}</a></li>
              ))}
            </ul>
          </section>
        )
      }

      <div class="notice enhancement" data-comparison-message role="status" aria-live="polite">
        Choose at least two products to begin.
      </div>

      <section class="comparison-questions enhancement" data-comparison-questions hidden aria-labelledby="supplier-questions-heading">
        <div class="section-intro">
          <div>
            <p class="eyebrow">Questions to settle</p>
            <h2 id="supplier-questions-heading">Questions worth taking to a supplier</h2>
          </div>
          <button type="button" class="button button--secondary" data-copy-questions>Copy questions</button>
        </div>
        <ul data-supplier-questions></ul>
      </section>

      <div class="table-scroll" data-comparison-table hidden>
        <table class="comparison-table">
          <caption>Field-level evidence for the selected products. Scroll horizontally on a small screen.</caption>
          <thead>
            <tr>
              <th scope="col">Decision field</th>
              {software.map((entry) => <th scope="col" data-product-column={entry.data.slug}>{entry.data.name}</th>)}
            </tr>
          </thead>
          <tbody data-comparison-group-heading="differences">
            <tr class="comparison-group-heading"><th colspan="5" scope="rowgroup">Key differences</th></tr>
          </tbody>
          <tbody data-comparison-group="differences">
            {decisionFieldDefinitions.map((definition) => (
              <tr data-comparison-row data-question={definition.question}>
                <th scope="row">{definition.label}</th>
                {software.map((entry) => {
                  const field = fieldsFor(entry.data.slug, definition.key);
                  const hasEvidence = Boolean(field);
                  return <td
                    data-product-column={entry.data.slug}
                    data-comparison-value={field?.value ?? ""}
                    data-evidence-state={field?.state ?? "question"}
                    data-has-evidence={hasEvidence ? "true" : "false"}
                    data-product-name={entry.data.name}
                  >
                    {field ? (
                      <>
                        <span class={`evidence-state evidence-state--${field.state}`}>{evidenceStateLabel(field.state)}</span>
                        <span>{field.value}</span>
                        {field.source && <small>Source: <a href={field.source.url} target="_blank" rel="noopener noreferrer">{field.source.label}</a> · {formatCompactDate(field.source.checked)}</small>}
                      </>
                    ) : (
                      <>
                        <span class="evidence-state evidence-state--question">Question to settle</span>
                        <small>{definition.question}</small>
                      </>
                    )}
                  </td>;
                })}
              </tr>
            ))}
          </tbody>
          <tbody data-comparison-group-heading="shared" hidden>
            <tr class="comparison-group-heading"><th colspan="5" scope="rowgroup"><button type="button" data-comparison-toggle="shared" aria-expanded="false">Shared characteristics <span data-comparison-group-count="shared"></span></button></th></tr>
          </tbody>
          <tbody data-comparison-group="shared" hidden>
          </tbody>
          <tbody data-comparison-group-heading="unresolved" hidden>
            <tr class="comparison-group-heading"><th colspan="5" scope="rowgroup"><button type="button" data-comparison-toggle="unresolved" aria-expanded="false">Questions to settle <span data-comparison-group-count="unresolved"></span></button></th></tr>
          </tbody>
          <tbody data-comparison-group="unresolved" hidden>
          </tbody>
          <tbody>
            <tr>
              <th scope="row">Full profile</th>
              {software.map((entry) => <td data-product-column={entry.data.slug}><a href={`/software/${entry.data.slug}/`}>Read {entry.data.name} profile</a></td>)}
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>
  <script src="../../scripts/comparison.ts"></script>
</BaseLayout>
