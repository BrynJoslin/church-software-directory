---
import { getCollection } from "astro:content";
import { siteConfig } from "../../config/site";
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  decisionFieldDefinitions,
  decisionFieldsFor,
  evidenceStateLabel,
  type DecisionField,
  type DecisionFieldKey
} from "../../utils/decision-evidence";
import { formatCompactDate } from "../../utils/content";

const software = (await getCollection("software")).sort((a, b) =>
  a.data.name.localeCompare(b.data.name)
);
const fieldsBySlug = new Map(
  software.map((entry) => [
    entry.data.slug,
    new Map(decisionFieldsFor(entry).map((field) => [field.key, field]))
  ])
);
const fieldsFor = (slug: string, key: DecisionFieldKey) =>
  fieldsBySlug.get(slug)?.get(key) as DecisionField;
---

<BaseLayout
  title="Compare church software"
  description="Compare two to four church software products using field-level evidence, current source dates and unresolved supplier questions."
  breadcrumbs={[{ label: "Compare" }]}
>
  <section class="section">
    <div class="container">
      <p class="eyebrow">Due diligence comparison</p>
      <h1>Compare church software</h1>
      <p class="measure">
        Choose two to four products. The comparison separates material differences,
        shared evidence and questions the recorded sources do not yet answer.
      </p>

      <noscript>
        <div class="notice">
          <p>
            Comparisons are enhanced in the browser. To review the available
            products, visit the <a href="/software/">software directory</a>.
          </p>
        </div>
      </noscript>

      <form class="comparison-picker enhancement" data-comparison-picker data-site-url={siteConfig.url}>
        <fieldset>
          <legend><strong>Products to compare</strong></legend>
          <p>Select at least two and no more than four.</p>
          <div class="check-grid">
            {software.map((entry) => (
              <label class="check-option">
                <input type="checkbox" name="products" value={entry.data.slug} />
                <span>{entry.data.name}</span>
              </label>
            ))}
          </div>
        </fieldset>
        <div class="cluster">
          <button type="button" data-copy-comparison>Copy comparison link</button>
          <a class="button button--secondary" href="/compare/">Clear selection</a>
        </div>
      </form>

      <div class="notice enhancement" data-comparison-message role="status" aria-live="polite">
        Choose at least two products to begin.
      </div>

      <section class="comparison-questions enhancement" data-comparison-questions hidden aria-labelledby="supplier-questions-heading">
        <div class="section-intro">
          <div>
            <p class="eyebrow">Unresolved supplier questions</p>
            <h2 id="supplier-questions-heading">Questions worth taking to a supplier</h2>
          </div>
          <button type="button" class="button button--secondary" data-copy-questions>Copy questions</button>
        </div>
        <ul data-supplier-questions></ul>
      </section>

      <div class="table-scroll" data-comparison-table hidden>
        <table class="comparison-table">
          <caption>Field-level evidence for the selected products. Scroll horizontally on a small screen.</caption>
          <thead>
            <tr>
              <th scope="col">Decision field</th>
              {software.map((entry) => <th scope="col" data-product-column={entry.data.slug}>{entry.data.name}</th>)}
            </tr>
          </thead>
          <tbody data-comparison-group-heading="differences">
            <tr class="comparison-group-heading"><th colspan="5" scope="rowgroup">Key differences</th></tr>
          </tbody>
          <tbody data-comparison-group="differences">
            {decisionFieldDefinitions.map((definition) => (
              <tr data-comparison-row data-question={definition.question}>
                <th scope="row">{definition.label}</th>
                {software.map((entry) => {
                  const field = fieldsFor(entry.data.slug, definition.key);
                  return <td
                    data-product-column={entry.data.slug}
                    data-comparison-value={field.value}
                    data-evidence-state={field.state}
                    data-product-name={entry.data.name}
                  >
                    <span class={`evidence-state evidence-state--${field.state}`}>{evidenceStateLabel(field.state)}</span>
                    <span>{field.value}</span>
                    {field.source ? <small>Source: <a href={field.source.url} rel="noopener noreferrer">{field.source.label}</a> · {formatCompactDate(field.source.checked)}</small> : <small>{field.note}</small>}
                  </td>;
                })}
              </tr>
            ))}
          </tbody>
          <tbody data-comparison-group-heading="shared" hidden>
            <tr class="comparison-group-heading"><th colspan="5" scope="rowgroup"><button type="button" data-comparison-toggle="shared" aria-expanded="false">Shared characteristics <span data-comparison-group-count="shared"></span></button></th></tr>
          </tbody>
          <tbody data-comparison-group="shared" hidden>
          </tbody>
          <tbody data-comparison-group-heading="unresolved" hidden>
            <tr class="comparison-group-heading"><th colspan="5" scope="rowgroup"><button type="button" data-comparison-toggle="unresolved" aria-expanded="false">Unresolved supplier questions <span data-comparison-group-count="unresolved"></span></button></th></tr>
          </tbody>
          <tbody data-comparison-group="unresolved" hidden>
          </tbody>
          <tbody>
            <tr>
              <th scope="row">Full profile</th>
              {software.map((entry) => <td data-product-column={entry.data.slug}><a href={`/software/${entry.data.slug}/`}>Read {entry.data.name} profile</a></td>)}
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>
  <script src="../../scripts/comparison.ts"></script>
</BaseLayout>
