---
import { getCollection, type CollectionEntry } from "astro:content";
import SoftwareCard from "../../components/SoftwareCard.astro";
import GuideCard from "../../components/GuideCard.astro";
import PublicFeedbackScan from "../../components/PublicFeedbackScan.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { siteConfig } from "../../config/site";
import { findRelatedProducts } from "../../utils/related-products";
import {
  evidenceStateLabel,
  evidenceSummaryFor
} from "../../utils/decision-evidence";
import {
  formatDate,
  formatStartingPrice,
  pricingModelLabel,
  triStateLabel,
  ukFocusLabel,
  ukOrganisationLabel
} from "../../utils/content";

export async function getStaticPaths() {
  const software = await getCollection("software");
  return software.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { entry }
  }));
}

type RelatedProduct = {
  entry: CollectionEntry<"software">;
  reason: string;
};

const { entry } = Astro.props;
const software = entry.data;
const [allSoftware, categories, guides] = await Promise.all([
  getCollection("software"),
  getCollection("categories"),
  getCollection("guides")
]);
const relatedCategories = categories.filter((category) =>
  software.categories.some((reference) => reference.id === category.id)
);
const relatedProducts = findRelatedProducts(entry, allSoftware);
const featuredGuides = guides.filter((guide) =>
  guide.data.featuredOnSoftware.some((profile) => profile.id === entry.id)
);
const categoryNames = Object.fromEntries(categories.map((category) => [category.id, category.data.name]));
const evidenceSummary = evidenceSummaryFor(entry);
const procurementVerdict = software.editorial.procurementVerdict;
const shortlistWhen = software.editorial.bestFor[0];
const firstUnresolvedQuestion = procurementVerdict?.firstCheck ?? software.editorial.limitations[0];
const ukFocus = ukFocusLabel(software.ukFocus);
const ukOrganisation = ukOrganisationLabel(software.ukOrganisation);
const pricingModel = pricingModelLabel(software.pricing.model);
const startingPrice = formatStartingPrice(software.pricing.startingPrice);
const freePlan = triStateLabel(software.freePlan);
const freeTrial = triStateLabel(software.freeTrial);
const giftAid = software.giftAid ? triStateLabel(software.giftAid) : null;
const hasOperations =
  Boolean(software.dataHosting) ||
  Boolean(software.gdprInformation) ||
  software.integrations.length > 0 ||
  software.importExport.length > 0 ||
  software.support.length > 0;
const longForm = software.longForm;
const publicFeedback = software.publicFeedback;
const hasAffiliateLink =
  siteConfig.features.affiliateLinks &&
  software.affiliateRelationship === "yes" &&
  Boolean(software.affiliateUrl);
const hasTicketTailorReferralOffer = software.slug === "ticket-tailor" && hasAffiliateLink;
const visitUrl = hasTicketTailorReferralOffer
  ? software.officialWebsite
  : hasAffiliateLink
    ? software.affiliateUrl!
    : software.officialWebsite;
const faqJsonLd = longForm
  ? {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      mainEntity: longForm.faq.map((item) => ({
        "@type": "Question",
        name: item.question,
        acceptedAnswer: { "@type": "Answer", text: item.answer }
      }))
    }
  : undefined;
---

<BaseLayout
  title={software.seo.title}
  description={software.seo.description}
  jsonLd={faqJsonLd}
  breadcrumbs={[
    { label: "Software", href: "/software/" },
    { label: software.name }
  ]}
>
  <section class="section">
    <div class="container page-grid">
      <article class="stack">
        <div class="card-heading">
          {
            software.brandAssets?.logo ? (
              <img
                class="software-logo"
                src={software.brandAssets.logo.src}
                alt={software.brandAssets.logo.alt}
              />
            ) : (
              <div class="logo-fallback" aria-hidden="true">
                {software.name.split(/\s+/).map((word) => word[0]).join("").slice(0, 2)}
              </div>
            )
          }
          <div>
            <p class="eyebrow">Software profile</p>
            <h1>{software.name}</h1>
          </div>
        </div>
        <p class="measure">{software.shortDescription}</p>
        <div class="cluster">
          <a
            class="button"
            href={visitUrl}
            target="_blank"
            rel={hasAffiliateLink && !hasTicketTailorReferralOffer ? "noopener noreferrer sponsored" : "noopener noreferrer"}
            data-referral-vendor={hasAffiliateLink && !hasTicketTailorReferralOffer ? software.name : undefined}
          >
            {hasAffiliateLink && !hasTicketTailorReferralOffer ? "Visit official website (affiliate link)" : "Visit official website"}
          </a>
          <a
            class="button button--secondary"
            href="/compare/"
            data-comparison-product={software.slug}
          >
            Add to comparison
          </a>
        </div>
        {
          hasTicketTailorReferralOffer && (
            <aside class="notice referral-offer" aria-label="Ticket Tailor referral offer">
              <p class="eyebrow">Ticket Tailor referral credit</p>
              <p>
                New to Ticket Tailor? Sign up through our referral link to receive 50 free ticket credits.
              </p>
              <p>
                <a
                  class="button button--secondary"
                  href={software.affiliateUrl}
                  target="_blank"
                  rel="noopener noreferrer sponsored"
                  data-referral-vendor={software.name}
                >
                  Get 50 free ticket credits
                </a>
              </p>
              <p class="muted">
                This referral link may earn Church Software UK a commission. It does not affect this profile’s assessment or ranking.
                <a href="/affiliate-disclosure/"> Read our commercial disclosure.</a>
              </p>
            </aside>
          )
        }
        {
          (hasAffiliateLink || software.sponsored) && !hasTicketTailorReferralOffer && (
            <aside class="notice" aria-label="Commercial disclosure">
              {hasAffiliateLink && (
                <p>
                  <strong>Affiliate disclosure:</strong> this link may earn Church Software UK a commission if you make a qualifying purchase. It does not affect this profile’s assessment or ranking.
                </p>
              )}
              {software.sponsored && (
                <p>
                  <strong>Sponsored listing:</strong> the supplier has paid for this placement. Sponsorship does not affect this profile’s assessment or ranking.
                </p>
              )}
              <p><a href="/affiliate-disclosure/">Read our commercial disclosure.</a></p>
            </aside>
          )
        }

        <section class="profile-summary" aria-labelledby="summary-heading">
          <p class="eyebrow">30-second answer</p>
          <h2 id="summary-heading">What to know before you open the full record</h2>
          <dl class="detail-list">
            <div>
              <dt>What it is</dt>
              <dd>{software.shortDescription}</dd>
            </div>
            {
              (software.suitableContexts.length > 0 || shortlistWhen) && (
                <div>
                  <dt>Contexts worth testing</dt>
                  <dd>{software.suitableContexts.length > 0 ? software.suitableContexts.join(", ") : shortlistWhen}</dd>
                </div>
              )
            }
            {startingPrice && <div><dt>Published starting price</dt><dd>{startingPrice}</dd></div>}
            {
              (ukFocus || ukOrganisation || giftAid) && (
                <div>
                  <dt>Relevant UK checks</dt>
                  <dd>{[ukFocus, ukOrganisation, giftAid ? `Gift Aid: ${giftAid}` : null].filter(Boolean).join(" · ")}</dd>
                </div>
              )
            }
            {shortlistWhen && <div><dt>Shortlist when</dt><dd>{shortlistWhen}</dd></div>}
            {firstUnresolvedQuestion && <div><dt>Check first</dt><dd>{firstUnresolvedQuestion}</dd></div>}
            <div>
              <dt>Evidence date</dt>
              <dd>Sources checked {formatDate(software.lastChecked)}</dd>
            </div>
          </dl>
          <p class="profile-summary__boundary">
            This is an evidence-led starting point, not a ranking or hands-on
            verdict. Supplier sources establish what they publish; your church
            should test material workflows and resolve the questions below.
          </p>
        </section>

        <section class="profile-section" aria-labelledby="five-minute-heading">
          <p class="eyebrow">Five-minute assessment</p>
          <h2 id="five-minute-heading">Assess the likely fit and trade-offs</h2>
        </section>

        {
          longForm && (
            <section class="profile-verdict" aria-labelledby="verdict-heading">
              <p class="eyebrow">The short version</p>
              <h2 id="verdict-heading">A fit worth testing against your real workflow.</h2>
              <p>{longForm.verdict}</p>
            </section>
          )
        }

        <section aria-labelledby="assessment-heading">
          <h2 id="assessment-heading">Directory assessment</h2>
          <p>{software.editorial.assessment}</p>
        </section>

        {publicFeedback && <PublicFeedbackScan feedback={publicFeedback} reviews={software.externalReviews} />}

        {
          procurementVerdict && (
            <section class="profile-verdict" aria-labelledby="procurement-verdict-heading">
              <p class="eyebrow">Decision framing</p>
              <h2 id="procurement-verdict-heading">Shortlist when, then check first</h2>
              <dl class="detail-list">
                <div>
                  <dt>Shortlist when</dt>
                  <dd>{procurementVerdict.problem}</dd>
                </div>
                <div>
                  <dt>Test in a real workflow</dt>
                  <dd>{procurementVerdict.differentiator}</dd>
                </div>
                <div>
                  <dt>Settle before buying</dt>
                  <dd>{procurementVerdict.firstCheck}</dd>
                </div>
              </dl>
            </section>
          )
        }

        {
          evidenceSummary.fields.length > 0 && (
            <section aria-labelledby="decision-evidence-heading">
              <p class="eyebrow">Decision evidence</p>
              <h2 id="decision-evidence-heading">Published details for a shortlist</h2>
              <p class="measure">
                These details are traced to the source shown. Supplier material
                establishes what the supplier publishes; it is not hands-on testing.
              </p>
              <dl class="detail-list decision-evidence-list">
                {evidenceSummary.fields.map((field) => (
                  <div>
                    <dt>{field.label}</dt>
                    <dd>
                      <span class={`evidence-state evidence-state--${field.state}`}>{evidenceStateLabel(field.state)}</span>
                      <span>{field.value}</span>
                      {field.source && (
                        <small>Source: <a href={field.source.url} target="_blank" rel="noopener noreferrer">{field.source.label}</a> · checked {formatDate(field.source.checked)}</small>
                      )}
                    </dd>
                  </div>
                ))}
              </dl>
            </section>
          )
        }

        <section aria-labelledby="fit-heading">
          <h2 id="fit-heading">Best suited to</h2>
          <ul>{software.editorial.bestFor.map((item) => <li>{item}</li>)}</ul>
        </section>

        <div class="grid">
          <section>
            <h2>Evidence-backed strengths</h2>
            <ul>{software.editorial.strengths.map((item) => <li>{item}</li>)}</ul>
          </section>
          <section>
            <h2>Limitations and questions</h2>
            <ul>
              {software.editorial.limitations.map((item) => <li>{item}</li>)}
            </ul>
          </section>
        </div>

        {
          software.coreFeatures.length > 0 && (
            <section aria-labelledby="features-heading">
              <h2 id="features-heading">What the supplier publishes</h2>
              <ul>{software.coreFeatures.map((item) => <li>{item}</li>)}</ul>
            </section>
          )
        }

        <section class="pricing-section" aria-labelledby="pricing-heading">
          <p class="section-question">What does the supplier currently publish?</p>
          <h2 id="pricing-heading">Pricing and trial</h2>
          <p>{software.pricing.summary}</p>
          {
            software.pricing.tiers.length > 0 ? (
              <div class="table-scroll">
                <table class="pricing-table">
                  <caption>Published pricing structure. Check the supplier for current terms and total cost.</caption>
                  <thead>
                    <tr>
                      <th scope="col">Tier or starting point</th>
                      <th scope="col">Published price</th>
                      <th scope="col">What it covers</th>
                    </tr>
                  </thead>
                  <tbody>
                    {software.pricing.tiers.map((tier) => (
                      <tr>
                        <th scope="row">{tier.label}</th>
                        <td>{tier.price}</td>
                        <td>{tier.detail}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            ) : null
          }
          {
            (freeTrial || software.pricing.trialDetails) && (
              <p>
                <strong>Free trial:</strong> {freeTrial ?? "Ask the supplier about an evaluation"}
                {software.pricing.trialDetails && ` — ${software.pricing.trialDetails}`}
              </p>
            )
          }
        </section>

        {
          longForm && (
            <>
              <aside class="decision-lens" aria-labelledby="lens-heading">
                <p class="eyebrow">The decision lens</p>
                <h2 id="lens-heading">{longForm.decisionLens.heading}</h2>
                <p>{longForm.decisionLens.text}</p>
              </aside>

              {longForm.sections.map((section) => (
                <section class="profile-section" aria-labelledby={`${section.heading.toLowerCase().replaceAll(/[^a-z0-9]+/g, "-")}-heading`}>
                  <p class="section-question">{section.question}</p>
                  <h2 id={`${section.heading.toLowerCase().replaceAll(/[^a-z0-9]+/g, "-")}-heading`}>
                    {section.heading}
                  </h2>
                  {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
                </section>
              ))}

              {!publicFeedback && <section class="profile-section" aria-labelledby="feedback-heading">
                <p class="section-question">What does external feedback add?</p>
                <h2 id="feedback-heading">What public reviews and peer discussion do — and do not — show</h2>
                <p>{longForm.userFeedback.summary}</p>
                <ul>{longForm.userFeedback.themes.map((theme) => <li>{theme}</li>)}</ul>
                <p class="muted">{longForm.userFeedback.caveat}</p>
              </section>}

              <section class="profile-section" aria-labelledby="faq-heading">
                <p class="section-question">The questions a shortlist needs to answer</p>
                <h2 id="faq-heading">{software.name} FAQs</h2>
                <div class="faq-list">
                  {longForm.faq.map((item) => (
                    <details>
                      <summary>{item.question}</summary>
                      <p>{item.answer}</p>
                    </details>
                  ))}
                </div>
              </section>
            </>
          )
        }

        <section class="profile-section" aria-labelledby="due-diligence-heading">
          <p class="eyebrow">Full due diligence</p>
          <h2 id="due-diligence-heading">Evidence, operations and source record</h2>
          <p>Use this full record to test practical details, retain source links and take specific gaps to the supplier.</p>
        </section>

        {
          hasOperations && (
            <section aria-labelledby="operations-heading">
              <h2 id="operations-heading">Published operations and support details</h2>
              <dl class="detail-list">
                {software.dataHosting && <div><dt>Data hosting</dt><dd>{software.dataHosting}</dd></div>}
                {software.gdprInformation && <div><dt>Data protection information</dt><dd>{software.gdprInformation}</dd></div>}
                {software.integrations.length > 0 && <div><dt>Integrations</dt><dd>{software.integrations.join(", ")}</dd></div>}
                {software.importExport.length > 0 && <div><dt>Import and export</dt><dd>{software.importExport.join(", ")}</dd></div>}
                {software.support.length > 0 && <div><dt>Support</dt><dd>{software.support.join(", ")}</dd></div>}
              </dl>
            </section>
          )
        }

        <section aria-labelledby="sources-heading">
          <h2 id="sources-heading">Sources reviewed</h2>
          <p>
            Sources support only the fields named beneath each link. Supplier
            material is not independent testing; external review material is
            included as a limited signal rather than a verdict.
          </p>
          <ol class="source-list">
            {
              software.sources.map((source) => (
                <li>
                  <a href={source.url} target="_blank" rel="noopener noreferrer">
                    {source.label}
                  </a>
                  <br />
                  <span class="muted">
                    Checked {formatDate(source.checked)} · Supports:{" "}
                    {source.supports.join(", ")}
                  </span>
                </li>
              ))
            }
          </ol>
        </section>
      </article>

      <aside class="aside-card">
        <h2>At a glance</h2>
        <dl class="detail-list">
          {ukFocus && <div><dt>UK focus</dt><dd>{ukFocus}</dd></div>}
          {ukOrganisation && <div><dt>Organisation</dt><dd>{ukOrganisation}</dd></div>}
          {software.suitableContexts.length > 0 && <div><dt>Editorial fit contexts</dt><dd>{software.suitableContexts.join(", ")}</dd></div>}
          {pricingModel && <div><dt>Pricing model</dt><dd>{pricingModel}</dd></div>}
          {startingPrice && <div><dt>Published from</dt><dd>{startingPrice}</dd></div>}
          {freePlan && <div><dt>Free plan</dt><dd>{freePlan}</dd></div>}
          {freeTrial && <div><dt>Free trial</dt><dd>{freeTrial}</dd></div>}
          {giftAid && <div><dt>Gift Aid</dt><dd>{giftAid}</dd></div>}
          <div>
            <dt>Sources checked</dt>
            <dd>{formatDate(software.lastChecked)}</dd>
          </div>
        </dl>
        <p>{software.pricing.summary}</p>
        {
          software.pricing.startingPrice?.qualifier && (
            <p class="muted">{software.pricing.startingPrice.qualifier}.</p>
          )
        }
        <h2>Categories</h2>
        <ul>
          {
            relatedCategories.map((category) => (
              <li>
                <a href={`/categories/${category.data.slug}/`}>
                  {category.data.name}
                </a>
              </li>
            ))
          }
        </ul>
        <p class="muted">
          {software.sponsored
            ? "Sponsored listing."
            : software.affiliateRelationship === "yes"
              ? "Affiliate relationship disclosed. This listing is not sponsored."
              : "No affiliate relationship. This listing is not sponsored."}
        </p>
      </aside>
    </div>
  </section>

  {
    featuredGuides.length > 0 && (
      <section class="section" aria-labelledby="product-guides-heading">
        <div class="container">
          <div class="section-intro">
            <div>
              <p class="eyebrow">Decision support</p>
              <h2 id="product-guides-heading">Guides that discuss {software.name}</h2>
            </div>
            <p>These guides use this profile as a relevant example or comparison point. Inclusion is not a ranking, testing result or endorsement.</p>
          </div>
          <div class="grid">
            {featuredGuides.map((guide) => <GuideCard entry={guide} categoryNames={categoryNames} analyticsEvent="guide_open_from_software" />)}
          </div>
        </div>
      </section>
    )
  }

  {
    relatedProducts.length > 0 && (
      <section class="section section--soft" aria-labelledby="related-heading">
        <div class="container">
          <h2 id="related-heading">Related products</h2>
          <div class="software-grid">
            {relatedProducts.map(
              (related: RelatedProduct) => (
                <div>
                  <SoftwareCard entry={related.entry} />
                  <p class="related-reason">Why shown: {related.reason}</p>
                  <p class="related-reason"><a href="/compare/" data-comparison-products={`${software.slug},${related.entry.data.slug}`}>Compare similar products</a></p>
                </div>
              )
            )}
          </div>
        </div>
      </section>
    )
  }
</BaseLayout>
