---
import { getCollection } from "astro:content";
import SoftwareCard from "../../components/SoftwareCard.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getDirectoryStats } from "../../utils/directory-stats";

const [software, categories] = await Promise.all([
  getCollection("software"),
  getCollection("categories")
]);
software.sort((a, b) => a.data.name.localeCompare(b.data.name));
categories.sort((a, b) => a.data.name.localeCompare(b.data.name));
const directoryStats = getDirectoryStats(software);
const itemListJsonLd = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "Church software directory",
  numberOfItems: directoryStats.listingCount,
  itemListElement: software.map((entry, index) => ({
    "@type": "ListItem",
    position: index + 1,
    url: new URL(`/software/${entry.data.slug}/`, Astro.site).href,
    name: entry.data.name
  }))
};
---

<BaseLayout
  title="Church software directory"
  description="Search and filter independently researched church software by category, UK focus, pricing, free options and relevant giving workflows."
  breadcrumbs={[{ label: "Software" }]}
  jsonLd={itemListJsonLd}
>
  <section class="section page-hero page-hero--tool directory-hero">
    <div class="container page-hero__grid">
      <div class="page-hero__intro">
        <p class="eyebrow">{directoryStats.listingCount} researched profiles</p>
        <h1>Church software directory</h1>
        <p>
          Search supplier-sourced facts and independent directory assessments.
          Details without useful evidence are omitted from cards.
        </p>
      </div>
      <dl class="page-hero__facts" aria-label="Directory evidence">
        <div>
          <dt>Profiles</dt>
          <dd>{directoryStats.listingCount}</dd>
        </div>
        <div>
          <dt>Dated sources</dt>
          <dd>{directoryStats.sourceLinkCount}</dd>
        </div>
        <div>
          <dt>Next step</dt>
          <dd><a href="/shortlist/">Build a guided shortlist</a></dd>
        </div>
      </dl>
    </div>
  </section>

  <section class="section directory-workspace" aria-label="Search and filter software">
    <div class="container">
      <noscript>
        <div class="notice">
          <p>
            All listings are shown below. Enable JavaScript to filter and sort
            them on this page.
          </p>
        </div>
      </noscript>

      <div class="directory-layout">
        <aside class="filter-panel enhancement" aria-labelledby="filter-heading">
          <h2 id="filter-heading">Filter software</h2>
          <form action="/software/" method="get" data-directory-form data-analytics-event="directory_search_or_filter">
            <div class="form-field">
              <label for="directory-search">Keyword</label>
              <input
                id="directory-search"
                name="q"
                type="search"
                autocomplete="off"
                placeholder="Name, feature or use"
              />
            </div>
            <div class="form-field">
              <label for="category">Category</label>
              <select id="category" name="category">
                <option value="">All categories</option>
                {
                  categories.map((category) => (
                    <option value={category.id}>{category.data.name}</option>
                  ))
                }
              </select>
            </div>
            <div class="form-field">
              <label for="uk-focus">UK focus</label>
              <select id="uk-focus" name="uk-focus">
                <option value="">Any UK focus</option>
                <option value="strong">UK-specific evidence</option>
                <option value="general">Available more broadly</option>
              </select>
            </div>
            <div class="form-field">
              <label for="uk-organisation">Organisation location</label>
              <select id="uk-organisation" name="uk-organisation">
                <option value="">Any organisation</option>
                <option value="yes">UK-registered organisation</option>
              </select>
              <p class="field-hint">
                Includes companies and charities where the recorded sources confirm UK registration.
              </p>
            </div>
            <div class="form-field">
              <label for="free-plan">Free plan</label>
              <select id="free-plan" name="free-plan">
                <option value="">Any status</option>
                <option value="yes">Available</option>
                <option value="no">Not available</option>
              </select>
            </div>
            <div class="form-field">
              <label for="free-trial">Free trial</label>
              <select id="free-trial" name="free-trial">
                <option value="">Any status</option>
                <option value="yes">Available</option>
                <option value="no">Not available</option>
              </select>
            </div>
            <div class="form-field">
              <label for="gift-aid">Gift Aid workflow</label>
              <select id="gift-aid" name="gift-aid">
                <option value="">Any status</option>
                <option value="yes">Supplier publishes a Gift Aid workflow</option>
                <option value="no">Supplier states it is unavailable</option>
              </select>
            </div>
            <div class="form-field">
              <label for="pricing">Pricing model</label>
              <select id="pricing" name="pricing">
                <option value="">Any model</option>
                <option value="free">Free</option>
                <option value="freemium">Freemium</option>
                <option value="flat-rate">Flat rate</option>
                <option value="tiered">Tiered</option>
                <option value="usage-based">Usage based</option>
                <option value="quote-based">Quote based</option>
              </select>
            </div>
            <div class="form-field">
              <label for="sort">Sort by</label>
              <select id="sort" name="sort">
                <option value="name">Name</option>
                <option value="last-checked">Last checked</option>
              </select>
            </div>
            <div class="filter-actions">
              <button type="submit">Apply filters</button>
              <button class="button--secondary" type="button" data-clear-filters data-analytics-event="directory_clear_filters">
                Clear all
              </button>
            </div>
          </form>
        </aside>

        <div>
          <div class="results-toolbar">
            <p id="result-count" role="status" aria-live="polite">
              {directoryStats.listingCount} results
            </p>
            <a href="/compare/">Compare two to four products</a>
          </div>
          <div class="software-grid" data-software-results>
            {
              software.map((entry) => (
                <SoftwareCard
                  entry={entry}
                  filterable
                />
              ))
            }
          </div>
          <p class="result-reveal-status enhancement" data-result-reveal-status role="status" aria-live="polite"></p>
          <p class="result-reveal-actions enhancement">
            <button class="button button--secondary" type="button" data-show-more-results data-analytics-event="directory_show_more">Show more products</button>
          </p>
          <div class="empty-state" data-empty-state hidden>
            <h2>No software matches those filters</h2>
            <p>
              Try removing one or more filters. A profile only matches a factual
              filter when the directory has supporting evidence for that value.
            </p>
            <button class="button--secondary" type="button" data-empty-clear data-analytics-event="directory_clear_filters">
              Clear all filters
            </button>
          </div>
        </div>
      </div>
    </div>
  </section>
  <script src="../../scripts/directory.ts"></script>
</BaseLayout>
