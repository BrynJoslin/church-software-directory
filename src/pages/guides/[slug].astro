---
import { getCollection, render, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import GuideContents from "../../components/GuideContents.astro";
import GuideCard from "../../components/GuideCard.astro";
import { formatDate } from "../../utils/content";

export async function getStaticPaths() {
  const guides = await getCollection("guides");
  return guides.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { entry }
  }));
}

interface Props {
  entry: CollectionEntry<"guides">;
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const [categories, guides] = await Promise.all([
  getCollection("categories"),
  getCollection("guides")
]);
const relatedCategories = categories.filter((category) =>
  entry.data.relatedCategories.some((reference) => reference.id === category.id)
);
const nextGuides = entry.data.nextGuides.flatMap((reference) => {
  const guide = guides.find((candidate) => candidate.id === reference.id);
  return guide ? [guide] : [];
});
const categoryNames = Object.fromEntries(categories.map((category) => [category.id, category.data.name]));
const articleJsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: entry.data.title,
  description: entry.data.summary,
  datePublished: entry.data.published.toISOString(),
  dateModified: entry.data.updated.toISOString(),
  mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).href
};
---

<BaseLayout
  title={entry.data.seo.title}
  description={entry.data.seo.description}
  type="article"
  jsonLd={articleJsonLd}
  breadcrumbs={[
    { label: "Guides", href: "/guides/" },
    { label: entry.data.title }
  ]}
  editorialHero
>
  <section class="section page-hero page-hero--editorial article-hero">
    <div class="container page-grid">
      <header class="page-hero__intro">
        <p class="eyebrow">Practical guide</p>
        <h1>{entry.data.title}</h1>
        <p>{entry.data.summary}</p>
        <p class="muted">
          Published <time datetime={entry.data.published.toISOString().slice(0, 10)}>
            {formatDate(entry.data.published)}
          </time>
          · Updated <time datetime={entry.data.updated.toISOString().slice(0, 10)}>
            {formatDate(entry.data.updated)}
          </time>
        </p>
      </header>
      <aside class="aside-card page-hero__panel">
        <h2>Related categories</h2>
        <ul>
          {
            relatedCategories.map((category) => (
              <li>
                <a href={`/categories/${category.data.slug}/`}>
                  {category.data.name}
                </a>
              </li>
            ))
          }
        </ul>
        <p>
          Product and regulatory details can change. Check material decisions
          with suppliers and qualified advisers.
        </p>
      </aside>
    </div>
  </section>

  <section class="section guide-body">
    <div class="container guide-reading-layout">
      <article class="prose">
        <GuideContents headings={headings} />
        <Content />
        <section class="guide-continuation" aria-labelledby="continue-heading">
          <p class="eyebrow">Keep moving</p>
          <h2 id="continue-heading">Continue your decision</h2>
          <p>These next guides follow the same decision journey. They are not a ranking or a complete set of related products.</p>
          <div class="grid">
            {nextGuides.map((guide) => <GuideCard entry={guide} categoryNames={categoryNames} analyticsEvent="guide_continue_open" />)}
          </div>
        </section>
      </article>
    </div>
  </section>
</BaseLayout>

<script src="../../scripts/prose-tables.ts"></script>
