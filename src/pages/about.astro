---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { siteConfig } from "../config/site";
import { getDirectoryStats } from "../utils/directory-stats";

const software = await getCollection("software");
const directoryStats = getDirectoryStats(software);
const correctionRoute = siteConfig.publisher.correctionRoute?.startsWith(siteConfig.url)
  ? siteConfig.publisher.correctionRoute.slice(siteConfig.url.length) || "/"
  : siteConfig.publisher.correctionRoute;
---

<BaseLayout
  title="About the directory"
  description="Why Church Software UK exists, who it serves and how it aims to support careful, independent church software decisions."
  breadcrumbs={[{ label: "About" }]}
>
  <section class="section editorial-page">
    <div class="container page-grid">
      <article class="prose">
        <header class="article-intro">
          <p class="eyebrow">About the project</p>
          <h1>Better information for important decisions</h1>
          <p>
            Church Software UK helps church administrators, leaders,
            treasurers, safeguarding teams and volunteers discover and assess
            software used in ministry and operations.
          </p>
        </header>
        <h2>What makes it different</h2>
        <p>
          This is more than a list of supplier links. It records sources, dates
          and unanswered questions. It also covers UK issues such as Gift Aid,
          pounds sterling, charity tasks, data protection and support.
        </p>
        <h2>What it does not do</h2>
        <p>
          Inclusion is not endorsement. The site does not provide legal,
          financial, safeguarding or tax advice, and it does not replace a
          church's own checks before choosing.
        </p>
        <h2>Current catalogue</h2>
        <p>
          Church Software UK is live and currently includes {directoryStats.listingCount}{" "}
          researched profiles and {directoryStats.sourceLinkCount}{" "}dated source links.
          It is not a market-wide shortlist, and inclusion is not endorsement.
        </p>
        <h2>Publisher, accountability and corrections</h2>
        <p><strong>Publisher:</strong> {siteConfig.publisher.name}</p>
        <p>{siteConfig.publisher.background}</p>
        <p>
          <a href={correctionRoute}>Contact the publisher about a correction or update.</a>
        </p>
        <p>
          AI may assist with research organisation and drafting, but a human remains
          accountable for published claims and corrections.
        </p>
        <h2>How to use the directory</h2>
        <p>
          Start with the task that needs attention rather than a supplier name.
          Compare the published facts, note the unanswered questions, and ask a
          small group of users to test one ordinary task. A shortlist is a
          starting point for checks before choosing, not a purchase decision.
        </p>
        <p>
          For a shared starting point, use the shortlist tool; it only narrows
          recorded profiles and explains the evidence behind each result. Then
          record costs, ownership, data, exit and set-up questions before making
          a commitment.
        </p>
      </article>
      <aside class="aside-card">
        <h2>Read next</h2>
        <ul>
          <li><a href="/methodology/">Research methodology</a></li>
          <li><a href="/affiliate-disclosure/">Commercial disclosure</a></li>
          <li><a href="/guides/">Decision guides</a></li>
        </ul>
      </aside>
    </div>
  </section>
</BaseLayout>
