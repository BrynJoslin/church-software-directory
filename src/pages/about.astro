---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { siteConfig } from "../config/site";

const software = await getCollection("software");
---

<BaseLayout
  title="About the directory"
  description="Why Church Software UK exists, who it serves and how it aims to support careful, independent church software decisions."
  breadcrumbs={[{ label: "About" }]}
>
  <section class="section">
    <div class="container page-grid">
      <article class="prose">
        <p class="eyebrow">About the project</p>
        <h1>Better information for consequential decisions</h1>
        <p>
          Church Software UK helps church administrators, leaders,
          treasurers, safeguarding teams and volunteers discover and assess
          software used in ministry and operations.
        </p>
        <h2>What makes it different</h2>
        <p>
          The directory is designed as a decision resource rather than a list of
          supplier links. It records sources, dates and uncertainty, and pays
          attention to UK questions such as Gift Aid, pounds sterling, charity
          workflows, data protection and support availability.
        </p>
        <h2>What it does not do</h2>
        <p>
          Inclusion is not endorsement. The site does not provide legal,
          financial, safeguarding or tax advice, and it does not replace a
          church's own due diligence.
        </p>
        <h2>Current catalogue</h2>
        <p>
          The directory currently contains {software.length} researched listings.
          It is not a market-wide shortlist, and inclusion is not endorsement.
        </p>
        <h2>Publisher and correction route</h2>
        {
          siteConfig.publisher.name ? (
            <>
              <p><strong>Responsible publisher:</strong> {siteConfig.publisher.name}</p>
              {siteConfig.publisher.background && <p>{siteConfig.publisher.background}</p>}
              {siteConfig.publisher.correctionRoute && (
                <p><a href={siteConfig.publisher.correctionRoute}>Contact the publisher about a correction.</a></p>
              )}
            </>
          ) : (
            <p>
              The responsible publisher, public contact route and relevant background
              have not yet been supplied for publication. Until they are confirmed,
              the directory is not ready to launch publicly.
            </p>
          )
        }
        <p>
          AI may assist with research organisation and drafting, but a human remains
          accountable for published claims and corrections.
        </p>
      </article>
      <aside class="aside-card">
        <h2>Read next</h2>
        <ul>
          <li><a href="/methodology/">Research methodology</a></li>
          <li><a href="/affiliate-disclosure/">Commercial disclosure</a></li>
          <li><a href="/guides/">Decision guides</a></li>
        </ul>
      </aside>
    </div>
  </section>
</BaseLayout>
