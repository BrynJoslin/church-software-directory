---
import type { BreadcrumbItem } from "../components/Breadcrumbs.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { siteConfig } from "../config/site";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  breadcrumbs?: BreadcrumbItem[];
  image?: string;
  type?: "website" | "article";
  noindex?: boolean;
  toolHero?: boolean;
  editorialHero?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description,
  breadcrumbs = [],
  image = siteConfig.defaultSeoImage,
  type = "website",
  noindex = false,
  toolHero = false,
  editorialHero = false,
  jsonLd
} = Astro.props;

const pageTitle = title.includes(siteConfig.shortName)
  ? title
  : `${title} | ${siteConfig.shortName}`;
const canonical = new URL(Astro.url.pathname, siteConfig.url);
const imageUrl = new URL(image, siteConfig.url);
const breadcrumbJsonLd =
  breadcrumbs.length > 0
    ? {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        itemListElement: [
          {
            "@type": "ListItem",
            position: 1,
            name: "Home",
            item: siteConfig.url
          },
          ...breadcrumbs.map((item, index) => ({
            "@type": "ListItem",
            position: index + 2,
            name: item.label,
            item: new URL(item.href ?? Astro.url.pathname, siteConfig.url).href
          }))
        ]
      }
    : undefined;
const structuredData = [
  ...(Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : []),
  ...(breadcrumbJsonLd ? [breadcrumbJsonLd] : [])
];
const googleAnalyticsId =
  siteConfig.analytics.enabled &&
  siteConfig.analytics.provider === "google-analytics"
    ? siteConfig.analytics.measurementId
    : undefined;
const googleAnalyticsScriptUrl = googleAnalyticsId
  ? `https://www.googletagmanager.com/gtag/js?id=${googleAnalyticsId}`
  : undefined;
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    {
      googleAnalyticsId && googleAnalyticsScriptUrl && (
        <>
          <script is:inline async src={googleAnalyticsScriptUrl}></script>
          <script is:inline define:vars={{ googleAnalyticsId }}>
            const analyticsWindow = /** @type {Window & typeof globalThis & { dataLayer?: unknown[]; gtag?: (...arguments_: unknown[]) => void }} */ (window);
            const consentKey = "church-software-analytics-consent";
            let analyticsStarted = false;

            analyticsWindow[`ga-disable-${googleAnalyticsId}`] = true;
            analyticsWindow.dataLayer = analyticsWindow.dataLayer || [];
            analyticsWindow.gtag = function gtag() {
              analyticsWindow.dataLayer?.push(arguments);
            };
            analyticsWindow.gtag("consent", "default", {
              ad_storage: "denied",
              analytics_storage: "denied",
              ad_user_data: "denied",
              ad_personalization: "denied"
            });
            analyticsWindow.gtag("js", new Date());

            const startAnalytics = () => {
              if (analyticsStarted || typeof analyticsWindow.gtag !== "function") return;

              analyticsStarted = true;
              analyticsWindow[`ga-disable-${googleAnalyticsId}`] = false;
              analyticsWindow.gtag("consent", "update", {
                ad_storage: "denied",
                analytics_storage: "granted",
                ad_user_data: "denied",
                ad_personalization: "denied"
              });
              analyticsWindow.gtag("config", googleAnalyticsId);
            };

            const stopAnalytics = () => {
              analyticsWindow.gtag?.("consent", "update", {
                ad_storage: "denied",
                analytics_storage: "denied",
                ad_user_data: "denied",
                ad_personalization: "denied"
              });
              analyticsWindow[`ga-disable-${googleAnalyticsId}`] = true;
              analyticsStarted = false;
            };

            try {
              if (localStorage.getItem(consentKey) === "accepted") startAnalytics();
            } catch {
              // If storage is unavailable, leave analytics disabled until a visitor can consent.
            }

            window.addEventListener("DOMContentLoaded", () => {
              const consentBanner = document.querySelector("[data-cookie-consent]");
              const acceptButton = document.querySelector("[data-consent-accept]");
              const rejectButton = document.querySelector("[data-consent-reject]");
              const settingsButton = document.querySelector("[data-cookie-settings]");

              const getConsent = () => {
                try {
                  return localStorage.getItem(consentKey);
                } catch {
                  return null;
                }
              };
              const hideBanner = () => consentBanner?.setAttribute("hidden", "");
              const showBanner = () => {
                consentBanner?.removeAttribute("hidden");
                if (acceptButton instanceof HTMLElement) acceptButton.focus();
              };
              const setConsent = (consent) => {
                try {
                  localStorage.setItem(consentKey, consent);
                } catch {
                  // Continue with the visitor's current-page choice when storage is unavailable.
                }
                hideBanner();
                if (consent === "accepted") startAnalytics();
                if (consent === "rejected") stopAnalytics();
              };

              if (!getConsent()) showBanner();
              acceptButton?.addEventListener("click", () => setConsent("accepted"));
              rejectButton?.addEventListener("click", () => setConsent("rejected"));
              settingsButton?.addEventListener("click", showBanner);

              document.addEventListener("click", (event) => {
                const target = event.target;
                if (!(target instanceof Element)) return;

                const analyticsTarget = target.closest("[data-analytics-event]");
                const analyticsEvent = analyticsTarget?.getAttribute("data-analytics-event");
                if (
                  analyticsEvent &&
                  getConsent() === "accepted" &&
                  typeof analyticsWindow.gtag === "function"
                ) {
                  analyticsWindow.gtag("event", analyticsEvent);
                }

                const comparisonLink = target.closest("a[data-comparison-product]");
                if (comparisonLink instanceof HTMLAnchorElement && comparisonLink.dataset.comparisonProduct) {
                  comparisonLink.href = `/compare/?products=${encodeURIComponent(comparisonLink.dataset.comparisonProduct)}`;
                }
                const comparisonPairLink = target.closest("a[data-comparison-products]");
                if (comparisonPairLink instanceof HTMLAnchorElement && comparisonPairLink.dataset.comparisonProducts) {
                  comparisonPairLink.href = `/compare/?products=${encodeURIComponent(comparisonPairLink.dataset.comparisonProducts)}`;
                }

                const link = target.closest("a[data-referral-vendor]");
                const referralVendor =
                  link instanceof HTMLAnchorElement
                    ? link.dataset.referralVendor
                    : undefined;
                if (
                  getConsent() !== "accepted" ||
                  !referralVendor ||
                  typeof analyticsWindow.gtag !== "function"
                ) return;

                analyticsWindow.gtag("event", "referral", {
                  referral_vendor: referralVendor
                });
              });

              document.addEventListener("submit", (event) => {
                const form = event.target;
                if (!(form instanceof HTMLFormElement)) return;

                const analyticsEvent = form.dataset.analyticsEvent;
                if (
                  analyticsEvent &&
                  getConsent() === "accepted" &&
                  typeof analyticsWindow.gtag === "function"
                ) {
                  analyticsWindow.gtag("event", analyticsEvent);
                }
              });
            });
          </script>
        </>
      )
    }
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="preload"
      href="/fonts/plus-jakarta-sans-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
    {
      structuredData.map((data) => (
        <script
          is:inline
          type="application/ld+json"
          set:html={JSON.stringify(data)}
        />
      ))
    }
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <SiteHeader />
    <main id="main-content" tabindex="-1">
      {
        toolHero || editorialHero ? (
          <div class:list={["page-hero-shell", { "page-hero-shell--tool": toolHero, "page-hero-shell--editorial": editorialHero }]}>
            <div class="container">
              <Breadcrumbs items={breadcrumbs} />
            </div>
            <slot />
          </div>
        ) : (
          <>
            <div class="container">
              <Breadcrumbs items={breadcrumbs} />
            </div>
            <slot />
          </>
        )
      }
    </main>
    <SiteFooter />
    {
      googleAnalyticsId && (
        <>
          <aside
            class="cookie-consent"
            data-cookie-consent
            role="dialog"
            aria-labelledby="cookie-consent-heading"
            aria-describedby="cookie-consent-description"
            hidden
          >
            <div class="cookie-consent__content">
              <h2 id="cookie-consent-heading">Analytics cookies</h2>
              <p id="cookie-consent-description">
                We use Google Analytics to understand site use and supplier-link
                referrals. You can accept or reject analytics cookies.
                <a href="/privacy/">Read the privacy notice</a>.
              </p>
            </div>
            <div class="cookie-consent__actions">
              <button class="button button--secondary" type="button" data-consent-reject>Reject</button>
              <button class="button" type="button" data-consent-accept>Accept analytics</button>
            </div>
          </aside>
          <button class="cookie-settings" type="button" data-cookie-settings>
            Cookie settings
          </button>
        </>
      )
    }
  </body>
</html>
