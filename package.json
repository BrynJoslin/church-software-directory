{
  "name": "uk-church-software-directory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run prepare:data && astro dev",
    "check": "npm run prepare:data && astro check && node scripts/check-public-copy.mjs && node scripts/check-content-integrity.mjs && npm run check:guides",
    "check:guides": "node scripts/check-guides.mjs",
    "check:content": "node scripts/dashboard.mjs",
    "check:links": "node scripts/check-links.mjs",
    "test:dashboard": "node --test test/dashboard-analysis.test.mjs",
    "test:related": "node --test test/related-products.test.mjs",
    "check:phase4": "node scripts/check-phase4-content.mjs",
    "dashboard": "node scripts/dashboard.mjs",
    "dashboard:open": "node scripts/dashboard-open.mjs",
    "check:stale": "node scripts/check-stale.mjs",
    "prepare:public-feedback-ledger": "node scripts/create-public-feedback-ledger.mjs",
    "complete:public-feedback-scans": "node scripts/complete-public-feedback-scans.mjs",
    "prepare:data": "node scripts/export-software.mjs",
    "check:sitemap": "node scripts/check-sitemap.mjs",
    "check:internal-links": "node scripts/check-internal-links.mjs",
    "check:accessibility": "node scripts/check-accessibility.mjs",
    "build": "npm run prepare:data && npm run check:guides && astro build && node scripts/check-public-copy.mjs --built && node scripts/check-dashboard-output.mjs && npm run check:sitemap && npm run check:internal-links && npm run check:accessibility",
    "test:interactions": "node --experimental-strip-types --test test/interaction-state.test.mjs",
    "preview": "astro preview"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^7.1.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "typescript": "^5.9.2"
  }
}
